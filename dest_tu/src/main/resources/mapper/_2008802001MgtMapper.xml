    <update id="updateProcMatch">
        UPDATE dat_clr_cash_dtl t
          SET
            t.match_status = '1',
            --已匹配
            t.trade_code = '2008802001',
            --业务类型改为待遇支付退回
            t.respond_date = #{vRespondDate}
        WHERE t.account_date = #{inAccntDate, jdbcType=VARCHAR, javaType=String}
        AND t.account_seqno = #{inSeqNo, jdbcType=NUMERIC, javaType=Long}
        AND t.account_id = #{inAccntId, jdbcType=VARCHAR, javaType=String}
        AND t.interface_seq = #{inInterfaceSeq, jdbcType=NUMERIC, javaType=Long}
    </update>

