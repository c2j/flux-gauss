          'yyyymmdd'))
        FROM tmp_batchpay_submit t,
        dat_clr_cash_dtl s,
        dat_trustee_acnt_detail b,
        par_sys_plan p
        WHERE s.account_id = #{inAccntId, jdbcType=VARCHAR, javaType=String}
        AND s.account_date = #{inAccntDate, jdbcType=VARCHAR, javaType=String}
        AND s.account_seqno = #{inSeqNo, jdbcType=VARCHAR, javaType=String}
