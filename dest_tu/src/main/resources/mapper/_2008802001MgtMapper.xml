        SELECT
          t.trade_code,
          t.in_amount
        FROM dat_clr_cash_dtl t
        WHERE t.account_date = #{inAccntDate, jdbcType=VARCHAR, javaType=String}
        AND t.account_seqno = #{inSeqNo, jdbcType=NUMERIC, javaType=Long}
