    <select id="selectProcList" parameterType="string" resultType="object">
        SELECT
          COUNT(1)
        FROM dat_clr_cash_dtl t,
        dat_trustee_acnt_detail d
        WHERE t.trade_code IN('2008801001',
        '2008802001')
        AND t.account_id = #{inAccntId, jdbcType=VARCHAR, javaType=String}
        AND t.match_status = #{inMatchStatus, jdbcType=VARCHAR, javaType=String}
        AND t.account_date BETWEEN nvl(#{inAccntDate1, jdbcType=VARCHAR, javaType=String},
        '19000101')
        AND nvl(#{inAccntDate2, jdbcType=VARCHAR, javaType=String},
        '99991231')
        AND (t.respond_date BETWEEN nvl(#{inRespondDate1, jdbcType=VARCHAR, javaType=String},
        '19000101') AND nvl(#{inRespondDate2, jdbcType=VARCHAR, javaType=String},
        '99991231') OR t.respond_date IS NULL)
        AND t.interface_seq = d.interface_seq(+)
        AND (t.operation_status = decode(t.trade_code,
        '2008801001',
        '0',
        t.operation_status) OR decode(t.trade_code,
        '2008801001',
        '0',
        t.operation_status) IS NULL)
                LIMIT 1
    </select>

