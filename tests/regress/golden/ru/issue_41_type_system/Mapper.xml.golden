    <!-- Source: {FIXTURES_ROOT}/issue_41_type_system.sql:64-112 — pkg_issue41_types.proc_transfer.selectTIssue41Account -->
    <select id="selectTIssue41Account" resultType="java.math.BigDecimal">
        SELECT balance FROM t_issue41_account WHERE account_id = #{pFromAccount, jdbcType=BIGINT, javaType=Long}
                LIMIT 1
    </select>

    <!-- Source: {FIXTURES_ROOT}/issue_41_type_system.sql:64-112 — pkg_issue41_types.proc_transfer.updateTIssue41Account -->
    <update id="updateTIssue41Account">
        UPDATE t_issue41_account SET balance = #{vFromBalance, jdbcType=NUMERIC, javaType=java.math.BigDecimal} WHERE account_id = #{pFromAccount, jdbcType=BIGINT, javaType=Long}
    </update>

