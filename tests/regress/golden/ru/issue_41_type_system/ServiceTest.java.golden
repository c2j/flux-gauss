    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procTransfer_success() {
        Long pFromAccount = 100L;
        Long pToAccount = 100L;
        java.math.BigDecimal pAmount = new java.math.BigDecimal("99.99");
        java.sql.Date pTransferDate = java.sql.Date.valueOf("2024-01-01");
        Boolean pIsUrgent = true;
        AtomicReference<java.math.BigDecimal> pNewBalanceRef = new AtomicReference<>(java.math.BigDecimal.ZERO);
        AtomicReference<String> pStatusRef = new AtomicReference<>(null);
        when(issue41TypesMapper.selectTIssue41Account(any(), any(), any(), any(), any())).thenReturn(new java.math.BigDecimal("999.99"));
        when(issue41TypesMapper.updateTIssue41Account(any(), any(), any(), any(), any(), any())).thenReturn(1);
        when(issue41TypesMapper.selectTIssue41Account_1(any(), any(), any(), any(), any())).thenReturn(new java.math.BigDecimal("999.99"));
        when(issue41TypesMapper.updateTIssue41Account_1(any(), any(), any(), any(), any(), any())).thenReturn(1);
        when(issue41TypesMapper.selectTIssue41Account_2(any(), any())).thenReturn(new java.math.BigDecimal("999.99"));
        when(issue41TypesMapper.updateTIssue41Account_2(any(), any(), any())).thenReturn(1);
        { var m = new java.util.HashMap<String,Object>(); m.put("balance", java.math.BigDecimal.TEN); m.put("isActive", true); m.put("v_active", 1L); m.put("v_balance", java.math.BigDecimal.TEN); when(issue41TypesMapper.selectTIssue41Account_3(any())).thenReturn(m); }
        service.procTransfer(pFromAccount, pToAccount, pAmount, pTransferDate, pIsUrgent, pNewBalanceRef, pStatusRef);
        verify(issue41TypesMapper, atLeast(0)).updateTIssue41Account(any(), any(), any(), any(), any(), any());
    }

