    public void prcCursorFields(String pInFundCode) {
        String vCapDate = null;
        Long vCnt = 0L;
        String vDqDate = null;
        Object cDate = null;
        // for rDate in cursor c_date
        List<Map<String, Object>> rDateList = issue144cfMapper.selectPrcCursorFields(pInFundCode);
        if (rDateList == null) rDateList = new ArrayList<>();
        for (Map<String, Object> rDate : rDateList) {
            if (rDate.getOrDefault("withdrawalDate", rDate.get("withdrawal_date")) == null) {
                vCapDate = String.valueOf(rDate.getOrDefault("capDate", rDate.get("cap_date")));
                vDqDate = String.valueOf(rDate.getOrDefault("maturityDate", rDate.get("maturity_date")));
            } else {
                vCapDate = String.valueOf(rDate.getOrDefault("capDate", rDate.get("cap_date")));
                vDqDate = String.valueOf(rDate.getOrDefault("withdrawalDate", rDate.get("withdrawal_date")));
            }
            vCnt = vCnt + 1;
        }
    }
