<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.Issue144colsMapper">

    <!-- Source: {FIXTURES_ROOT}/issue_144_chain_loop_field.sql:21-61 — pkg_issue144cols.prc_move_cols.selectPrcMoveCols -->
    <select id="selectPrcMoveCols" resultType="java.util.LinkedHashMap">
        (SELECT t.column_name AS column_name FROM v_my_tab_columns_144 t WHERE t.table_name = #{vSourceTable, jdbcType=VARCHAR, javaType=String} AND t.column_name NOT IN ('USAGE'))
    </select>

    <!-- Source: {FIXTURES_ROOT}/issue_144_chain_loop_field.sql:21-61 — pkg_issue144cols.prc_move_cols.insertPrcMoveCols -->
    <insert id="insertPrcMoveCols">
        insert into ${vTargetTable}(${vColumns}) select ${vColumns} from ${vSourceTable} where INST_NUM = #{pIInstNum} AND INST_DATA_DATE = #{pIDataDate}${vSqlDiff}
    </insert>

</mapper>