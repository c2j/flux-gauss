    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_prcMoveCols_success() {
        Long pIInstNum = 100L;
        String pIDataDate = "20240101";
        AtomicReference<String> pORetcodeRef = new AtomicReference<>(null);
        AtomicReference<String> pORetmsgRef = new AtomicReference<>(null);
        { var m = new java.util.HashMap<String,Object>(); m.put("columnName", "test"); when(issue144colsMapper.selectPrcMoveCols((Long) any(), (String) any(), (String) any())).thenReturn(java.util.List.of(m)); }
        when(issue144colsMapper.insertPrcMoveCols((Long) any(), (String) any(), (Object) any(), (Object) any(), (Object) any(), (Object) any())).thenReturn(1);
        service.prcMoveCols(pIInstNum, pIDataDate, pORetcodeRef, pORetmsgRef);
        verify(issue144colsMapper, atLeast(0)).insertPrcMoveCols((Long) any(), (String) any(), (Object) any(), (Object) any(), (Object) any(), (Object) any());
    }
