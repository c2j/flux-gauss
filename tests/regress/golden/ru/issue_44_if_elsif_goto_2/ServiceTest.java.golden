@ExtendWith(MockitoExtension.class)
@MockitoSettings(strictness = Strictness.LENIENT)
// Source: {FIXTURES_ROOT}/issue_44_if_elsif_goto_2.sql
class Issue44NestedExcServiceTest {

    @Mock
    private Issue44NestedExcMapper issue44NestedExcMapper;

    @InjectMocks
    private Issue44NestedExcService service;

    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procNestedExceptionBlocks_success() {
        when(issue44NestedExcMapper.selectTIssue44Config()).thenReturn(0);
        when(issue44NestedExcMapper.selectTIssue44Config_1()).thenReturn("1");
        when(issue44NestedExcMapper.selectTIssue44Config_2((String) any())).thenReturn("1");
        service.procNestedExceptionBlocks();
    }
}