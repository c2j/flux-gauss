class DynamicXmlServiceTest {

    @Mock
    private DynamicXmlMapper dynamicXmlMapper;

    @InjectMocks
    private DynamicXmlService service;

    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procConditionalQuery_success() {
        String pTableName = "test_pTableName";
        String pWhereClause = "test_pWhereClause";
        String pOrderBy = "test_pOrderBy";
        Integer pLimit = 5;
        { var m = new java.util.HashMap<String,Object>(); m.put("id", 1L); m.put("name", "test"); m.put("amount", java.math.BigDecimal.TEN); m.put("status", "test"); m.put("createdAt", 1L); when(dynamicXmlMapper.selectProcConditionalQuery((String) any(), (String) any(), (String) any(), (Integer) any())).thenReturn(m); }
        when(dynamicXmlMapper.selectAuditLog((String) any(), (String) any(), (String) any(), (Integer) any())).thenReturn(999);
        when(dynamicXmlMapper.updateProcConditionalUpdate((String) any(), (Integer) any(), (String) any(), (Long) any(), (String) any())).thenReturn(1);
        when(dynamicXmlMapper.insertProcMixedLogic((String) any(), (String) any())).thenReturn(1);
        when(dynamicXmlMapper.insertAuditLog((String) any(), (String) any(), (String) any())).thenReturn(1);
        when(dynamicXmlMapper.deleteProcMixedLogic((String) any(), (String) any())).thenReturn(1);
        when(dynamicXmlMapper.insertAuditLog_1((String) any(), (String) any(), (String) any())).thenReturn(1);
        service.procConditionalQuery(pTableName, pWhereClause, pOrderBy, pLimit);
    }

    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procConditionalUpdate_success() {
        String pTableName = "test_pTableName";
        Integer pId = 1;
        String pStatus = "test_pStatus";
        Long pAmount = 100L;
        String pRemark = "test_pRemark";
        { var m = new java.util.HashMap<String,Object>(); m.put("id", 1L); m.put("name", "test"); m.put("amount", java.math.BigDecimal.TEN); m.put("status", "test"); m.put("createdAt", 1L); when(dynamicXmlMapper.selectProcConditionalQuery((String) any(), (String) any(), (String) any(), (Integer) any())).thenReturn(m); }
        when(dynamicXmlMapper.selectAuditLog((String) any(), (String) any(), (String) any(), (Integer) any())).thenReturn(999);
        when(dynamicXmlMapper.updateProcConditionalUpdate((String) any(), (Integer) any(), (String) any(), (Long) any(), (String) any())).thenReturn(1);
        when(dynamicXmlMapper.insertProcMixedLogic((String) any(), (String) any())).thenReturn(1);
        when(dynamicXmlMapper.insertAuditLog((String) any(), (String) any(), (String) any())).thenReturn(1);
        when(dynamicXmlMapper.deleteProcMixedLogic((String) any(), (String) any())).thenReturn(1);
        when(dynamicXmlMapper.insertAuditLog_1((String) any(), (String) any(), (String) any())).thenReturn(1);
        service.procConditionalUpdate(pTableName, pId, pStatus, pAmount, pRemark);
        verify(dynamicXmlMapper, atLeast(0)).updateProcConditionalUpdate((String) any(), (Integer) any(), (String) any(), (Long) any(), (String) any());
    }

    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procMixedLogic_success() {
        String pTableName = "test_pTableName";
        String pMode = "test_pMode";
        { var m = new java.util.HashMap<String,Object>(); m.put("id", 1L); m.put("name", "test"); m.put("amount", java.math.BigDecimal.TEN); m.put("status", "test"); m.put("createdAt", 1L); when(dynamicXmlMapper.selectProcConditionalQuery((String) any(), (String) any(), (String) any(), (Integer) any())).thenReturn(m); }
        when(dynamicXmlMapper.selectAuditLog((String) any(), (String) any(), (String) any(), (Integer) any())).thenReturn(999);
        when(dynamicXmlMapper.updateProcConditionalUpdate((String) any(), (Integer) any(), (String) any(), (Long) any(), (String) any())).thenReturn(1);
        when(dynamicXmlMapper.insertProcMixedLogic((String) any(), (String) any())).thenReturn(1);
        when(dynamicXmlMapper.insertAuditLog((String) any(), (String) any(), (String) any())).thenReturn(1);
        when(dynamicXmlMapper.deleteProcMixedLogic((String) any(), (String) any())).thenReturn(1);
