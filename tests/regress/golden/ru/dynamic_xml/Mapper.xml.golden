<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.DynamicXmlMapper">

<!-- Source: {FIXTURES_ROOT}/pkg_dynamic_xml.sql:47-78 — pkg_dynamic_xml.proc_conditional_query.selectProcConditionalQuery -->
<select id="selectProcConditionalQuery" resultType="java.util.LinkedHashMap">
    SELECT id, name, amount, status, created_at FROM t_test_funcs
    <where>
        <if test="pWhereClause != null">
            AND ${pWhereClause}
        </if>
    </where>
    <if test="pOrderBy != null">
        ORDER BY ${pOrderBy}
    </if>
    <if test="true">
        LIMIT ${pLimit}
    </if>
</select>

<!-- Source: {FIXTURES_ROOT}/pkg_dynamic_xml.sql:47-78 — pkg_dynamic_xml.proc_conditional_query.selectProcConditionalQuery_1 -->
<select id="selectProcConditionalQuery_1" resultType="int">
    select COUNT(*) FROM audit_log WHERE operation = 'QUERY'
            LIMIT 1
</select>

<!-- Source: {FIXTURES_ROOT}/pkg_dynamic_xml.sql:83-120 — pkg_dynamic_xml.proc_conditional_update.updateProcConditionalUpdate -->
<update id="updateProcConditionalUpdate">
    UPDATE ${pTableName}
    <where>
        <if test="true">
            AND id = ${pId}
        </if>
    </where>
</update>

<!-- Source: {FIXTURES_ROOT}/pkg_dynamic_xml.sql:126-150 — pkg_dynamic_xml.proc_mixed_logic.insertProcMixedLogic -->
<insert id="insertProcMixedLogic">
    INSERT INTO ${pTableName}_hist SELECT * FROM ${pTableName}
</insert>

<!-- Source: {FIXTURES_ROOT}/pkg_dynamic_xml.sql:126-150 — pkg_dynamic_xml.proc_mixed_logic.insertProcMixedLogic_1 -->
<insert id="insertProcMixedLogic_1">
    INSERT INTO audit_log(log_time, operation, sql_text) VALUES (CURRENT_TIMESTAMP, 'ARCHIVE', #{vSql, jdbcType=VARCHAR, javaType=String})
</insert>

<!-- Source: {FIXTURES_ROOT}/pkg_dynamic_xml.sql:126-150 — pkg_dynamic_xml.proc_mixed_logic.deleteProcMixedLogic -->
<delete id="deleteProcMixedLogic">
    DELETE FROM ${pTableName} WHERE create_time &lt; CURRENT_TIMESTAMP - 30
</delete>

<!-- Source: {FIXTURES_ROOT}/pkg_dynamic_xml.sql:126-150 — pkg_dynamic_xml.proc_mixed_logic.insertProcMixedLogic_2 -->
<insert id="insertProcMixedLogic_2">
    INSERT INTO audit_log(log_time, operation, sql_text) VALUES (CURRENT_TIMESTAMP, 'CLEAN', #{vSql, jdbcType=VARCHAR, javaType=String})
</insert>

</mapper>