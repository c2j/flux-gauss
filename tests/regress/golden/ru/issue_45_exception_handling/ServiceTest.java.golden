    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procLinkEtfRepay_success() {
        String pSecurityCode = "test_p_security_code";
        AtomicReference<String> pOSucceedRef = new AtomicReference<>(null);
        AtomicReference<String> pOSecurityIdRef = new AtomicReference<>(null);
        when(issue45ExceptionMapper.selectTIssue45Security((String) any())).thenReturn("1");
        when(issue45ExceptionMapper.selectTIssue45SecurityBak((String) any())).thenReturn("1");
        when(issue45ExceptionMapper.selectTIssue45Security_1((String) any())).thenReturn("1");
        when(issue45ExceptionMapper.selectTIssue45Security_2((String) any())).thenReturn("1");
        service.procLinkEtfRepay(pSecurityCode, pOSucceedRef, pOSecurityIdRef);
    }

