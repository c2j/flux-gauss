        select t.security_id FROM t_issue45_security t WHERE t.security_name = #{pSecurityCode, jdbcType=VARCHAR, javaType=String}
                LIMIT 1
    </select>

    <!-- Source: {FIXTURES_ROOT}/issue_45_exception_handling.sql:123-144 — pkg_issue45_exception.proc_nested_exception.selectTIssue45Security_2 -->
