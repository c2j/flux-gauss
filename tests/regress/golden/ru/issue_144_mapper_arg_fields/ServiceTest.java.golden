        { var m = new java.util.HashMap<String,Object>(); m.put("diffColumn", 1L); m.put("diffValue", 1L); m.put("tableName", "test"); when(issue144mpMapper.selectPrcModelLoop_1((String) any(), (Object) any(), (Object) any())).thenReturn(m); }
