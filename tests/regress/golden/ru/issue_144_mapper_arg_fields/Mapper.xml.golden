// ===== FILE: Issue144mpMapper.xml =====
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.Issue144mpMapper">

    <!-- Source: {FIXTURES_ROOT}/issue_144_mapper_arg_fields.sql:34-57 — pkg_issue144mp.prc_model_loop.selectPrcModelLoop -->
    <select id="selectPrcModelLoop" parameterType="string" resultType="java.util.LinkedHashMap">
        (SELECT table_name, diff_column, diff_value FROM par_issue144_model t WHERE t.operation_no = #{pIOperationNo, jdbcType=VARCHAR, javaType=String} ORDER BY t.forest_no)
    </select>

    <!-- Source: {FIXTURES_ROOT}/issue_144_mapper_arg_fields.sql:34-57 — pkg_issue144mp.prc_model_loop.selectPrcModelLoop_1 -->
    <select id="selectPrcModelLoop_1" resultType="java.util.LinkedHashMap">
        SELECT xmlforest(:element_name) FROM ${vTableName} WHERE SEQ_NO = :seq_no${vSqlDiff}
                LIMIT 1
    </select>

</mapper>