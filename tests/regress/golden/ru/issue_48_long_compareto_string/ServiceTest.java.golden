    void test_procCheckProId_success() {
        Long pProId = 1L;
        AtomicReference<String> pResultRef = new AtomicReference<>(null);
        when(issue48CompareMapper.selectDual((Long) any())).thenReturn(0);
        service.procCheckProId(pProId, pResultRef);
    }

    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procCheckCount_success() {
        Long pCount = 100L;
        AtomicReference<String> pLabelRef = new AtomicReference<>(null);
        when(issue48CompareMapper.selectDual((Long) any())).thenReturn(0);
        service.procCheckCount(pCount, pLabelRef);
    }

    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procCheckStatus_success() {
        String pStatus = "test_p_status";
        AtomicReference<Integer> pCodeRef = new AtomicReference<>(0);
        when(issue48CompareMapper.selectDual((Long) any())).thenReturn(0);
        service.procCheckStatus(pStatus, pCodeRef);
