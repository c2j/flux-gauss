    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procCompareLevel_success() {
        java.math.BigDecimal pLevel = new java.math.BigDecimal("99.99");
