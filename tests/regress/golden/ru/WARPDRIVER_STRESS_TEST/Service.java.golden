    @Transactional
    public void spGotoStateMachine(long pOrderId, String pEvent, AtomicReference<String> pFinalState) {
        String vDbState = null;
        Integer vMaxRetry = 3;
        Integer vRetry = 0;
        String vState = "INIT";
        // State machine generated from GOTO labels
        enum SpGotoStateMachineState { StateInit, StatePending, StatePaid, StateShipped, StateRefunding, StateCheck, StateDone }
        SpGotoStateMachineState currentState = SpGotoStateMachineState.StateInit;
        boolean running = true;
        int _smGuard = 0;
        while (running && _smGuard++ < 10000) {
            switch (currentState) {
                case StateInit:
                if (java.util.Objects.equals(pEvent, "SUBMIT")) {
                    warpdriverStressTestMapper.updateOrders(pOrderId, pEvent);
                    vState = "PENDING";
                    currentState = SpGotoStateMachineState.StatePending;
                    // UNREACHABLE: break;
                } else if (java.util.Objects.equals(pEvent, "RESUME")) {
                    currentState = SpGotoStateMachineState.StateCheck;
                    // UNREACHABLE: break;
                }
                currentState = SpGotoStateMachineState.StateDone;
                break;
                case StatePending:
                if (java.util.Objects.equals(pEvent, "PAY")) {
                    warpdriverStressTestMapper.updateOrders_1(pOrderId, pEvent);
                    vState = "PAID";
                    currentState = SpGotoStateMachineState.StatePaid;
                    // UNREACHABLE: break;
                } else if (java.util.Objects.equals(pEvent, "CANCEL")) {
                    warpdriverStressTestMapper.updateOrders_2(pOrderId, pEvent);
                    vState = "CANCELLED";
                    currentState = SpGotoStateMachineState.StateDone;
                    // UNREACHABLE: break;
                } else if (java.util.Objects.equals(pEvent, "TIMEOUT")) {
                    if (vRetry < vMaxRetry) {
                        vRetry = vRetry + 1;
                        warpdriverStressTestMapper.updateOrders_3(pOrderId, pEvent, vRetry);
                        currentState = SpGotoStateMachineState.StatePending;
                        // UNREACHABLE: break;
                    } else {
                        warpdriverStressTestMapper.updateOrders_4(pOrderId, pEvent);
                        vState = "EXPIRED";
                        currentState = SpGotoStateMachineState.StateDone;
                        // UNREACHABLE: break;
                    }
                }
                currentState = SpGotoStateMachineState.StateDone;
                break;
                case StatePaid:
                if (java.util.Objects.equals(pEvent, "SHIP")) {
                    warpdriverStressTestMapper.updateOrders_5(pOrderId, pEvent);
                    vState = "SHIPPED";
                    currentState = SpGotoStateMachineState.StateShipped;
                    // UNREACHABLE: break;
                } else if (java.util.Objects.equals(pEvent, "REFUND_REQ")) {
                    warpdriverStressTestMapper.updateOrders_6(pOrderId, pEvent);
                    vState = "REFUNDING";
                    currentState = SpGotoStateMachineState.StateRefunding;
                    // UNREACHABLE: break;
                }
                currentState = SpGotoStateMachineState.StateDone;
                break;
                case StateShipped:
                if (java.util.Objects.equals(pEvent, "DELIVER")) {
                    warpdriverStressTestMapper.updateOrders_7(pOrderId, pEvent);
                    vState = "COMPLETED";
                } else if (java.util.Objects.equals(pEvent, "RETURN")) {
                    warpdriverStressTestMapper.updateOrders_8(pOrderId, pEvent);
                    vState = "REFUNDING";
                    currentState = SpGotoStateMachineState.StateRefunding;
                    // UNREACHABLE: break;
                }
                currentState = SpGotoStateMachineState.StateDone;
                break;
                case StateRefunding:
                if (java.util.Objects.equals(pEvent, "REFUND_APPROVE")) {
                    warpdriverStressTestMapper.updateOrders_9(pOrderId, pEvent);
                    vState = "REFUNDED";
                    currentState = SpGotoStateMachineState.StateDone;
                    // UNREACHABLE: break;
                } else if (java.util.Objects.equals(pEvent, "REFUND_REJECT")) {
                    warpdriverStressTestMapper.updateOrders_10(pOrderId, pEvent);
                    vState = "PAID";
                    currentState = SpGotoStateMachineState.StatePaid;
                    // UNREACHABLE: break;
                } else if (java.util.Objects.equals(pEvent, "PARTIAL_REFUND")) {
                    warpdriverStressTestMapper.updateOrders_11(pOrderId, pEvent);
                    vState = "PAID";
                    currentState = SpGotoStateMachineState.StatePaid;
                    // UNREACHABLE: break;
                }
                currentState = SpGotoStateMachineState.StateDone;
                break;
                case StateCheck:
                vDbState = String.valueOf(warpdriverStressTestMapper.selectOrders(pOrderId, pEvent));
                vState = String.valueOf(vDbState);
                if (java.util.Objects.equals(vDbState, "PENDING")) {
                    currentState = SpGotoStateMachineState.StatePending;
                    // UNREACHABLE: break;
                }
                if (java.util.Objects.equals(vDbState, "PAID")) {
                    currentState = SpGotoStateMachineState.StatePaid;
                    // UNREACHABLE: break;
                }
                if (java.util.Objects.equals(vDbState, "SHIPPED")) {
                    currentState = SpGotoStateMachineState.StateShipped;
                    // UNREACHABLE: break;
                }
                if (java.util.Objects.equals(vDbState, "REFUNDING")) {
                    currentState = SpGotoStateMachineState.StateRefunding;
                    // UNREACHABLE: break;
                }
                currentState = SpGotoStateMachineState.StateDone;
                break;
                case StateDone:
                pFinalState.set(String.valueOf(vState));
                warpdriverStressTestMapper.insertStateTransitions(pOrderId, pEvent, vState);
                // COMMIT;
                break;
                default:
                running = false;
                break;
            }
        }
    }

