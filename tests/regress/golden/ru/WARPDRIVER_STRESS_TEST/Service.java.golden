            // for rec in query: (       SELECT region_code,              COUNT(*) AS cnt,              SUM(settle_amount) AS amt,              AVG(fee_rate) AS avg_fee       FROM settlement       WHERE settle_date = v_date       GROUP BY region_code       HAVING COUNT(*) > 10       ORDER BY amt DESC     )
