        SELECT order_id, total_amount, status FROM orders WHERE biz_date = #{vDate, jdbcType=DATE, javaType=java.sql.Date} AND status IN ('PENDING','PROCESSING') ORDER BY priority DESC LIMIT #{gBatchSize, jdbcType=INTEGER, javaType=Integer}
