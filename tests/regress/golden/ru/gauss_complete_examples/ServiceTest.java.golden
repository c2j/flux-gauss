        { var m = new java.util.HashMap<String,Object>(); m.put("employeeId", 1L); m.put("employeeName", "test"); m.put("salary", java.math.BigDecimal.TEN); m.put("departmentId", 1L); m.put("hireDate", java.sql.Date.valueOf("2024-01-01")); when(cursorLifecycleMapper.selectProcGetRawCursor((Integer) any())).thenReturn(java.util.List.of(m)); }
