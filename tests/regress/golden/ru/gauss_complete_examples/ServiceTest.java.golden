    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procDynamicForProcessing_success() {
        String pTableName = "test_pTableName";
        String pSelectColumns = "test_pSelectColumns";
        String pWhereClause = "test_pWhereClause";
        String pOrderBy = "test_pOrderBy";
        String pProcessType = "test_pProcessType";
        when(dynamicForLoopMapper.insertAuditLog(any(), any(), any(), any(), any(), any())).thenReturn(1);
        { var m = new java.util.HashMap<String,Object>(); m.put("#{expr0}", 1L); when(dynamicForLoopMapper.selectProcDynamicForProcessing(any(), any(), any(), any(), any())).thenReturn(java.util.List.of(m)); }
        when(dynamicForLoopMapper.insertProcDynamicForProcessing(any(), any(), any(), any(), any(), any())).thenReturn(1);
        when(dynamicForLoopMapper.updateProcDynamicForProcessing(any(), any(), any(), any(), any(), any())).thenReturn(1);
        when(dynamicForLoopMapper.updateProcDynamicForProcessing_1(any(), any(), any(), any(), any(), any())).thenReturn(1);
        when(dynamicForLoopMapper.updateProcDynamicForProcessing_2(any(), any(), any(), any(), any(), any())).thenReturn(1);
        when(dynamicForLoopMapper.insertScanLog(any(), any(), any(), any(), any(), any(), any())).thenReturn(1);
        when(dynamicForLoopMapper.insertPerformanceLog(any(), any(), any(), any(), any(), any(), any())).thenReturn(1);
        when(dynamicForLoopMapper.insertErrorLog(any(), any(), any(), any(), any(), any())).thenReturn(1);
        service.procDynamicForProcessing(pTableName, pSelectColumns, pWhereClause, pOrderBy, pProcessType);
        verify(dynamicForLoopMapper, atLeast(0)).insertAuditLog(any(), any(), any(), any(), any(), any());
    }
