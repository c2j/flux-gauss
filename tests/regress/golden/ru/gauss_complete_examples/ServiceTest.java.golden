    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procGetRawCursor_success() {
        Integer pDeptId = 1;
        AtomicReference<Object> pCursorRef = new AtomicReference<>(null);
        { var m = new java.util.HashMap<String,Object>(); m.put("employeeId", 1L); m.put("employeeName", "test"); m.put("salary", java.math.BigDecimal.TEN); m.put("departmentId", 1L); m.put("hireDate", java.sql.Date.valueOf("2024-01-01")); when(cursorLifecycleMapper.selectProcGetRawCursor(any())).thenReturn(java.util.List.of(m)); }
        when(cursorLifecycleMapper.insertProcEnhanceCursor(any(), any(), any(), any(), any(), any(), any())).thenReturn(1);
        service.procGetRawCursor(pDeptId, pCursorRef);
    }

