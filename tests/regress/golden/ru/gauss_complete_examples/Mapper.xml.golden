// ===== FILE: OpenCursorMapper.xml =====
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.OpenCursorMapper">

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:221-245 — pkg_open_cursor.proc_get_employee_cursor.selectProcGetEmployeeCursor -->
    <select id="selectProcGetEmployeeCursor" resultType="java.util.LinkedHashMap">
        SELECT e.employee_id, e.employee_name, e.salary, e.email, d.department_name, p.project_name, RANK() OVER (PARTITION BY e.department_id ORDER BY e.salary DESC) AS dept_salary_rank, PERCENT_RANK() OVER (ORDER BY e.salary) AS salary_percentile FROM employees e LEFT JOIN departments d ON e.department_id = d.department_id LEFT JOIN projects p ON e.current_project_id = p.project_id WHERE e.department_id = #{pDeptId, jdbcType=INTEGER, javaType=Integer} AND e.salary &gt;= #{pMinSalary, jdbcType=NUMERIC, javaType=java.math.BigDecimal} AND e.status = 'ACTIVE' ORDER BY e.salary DESC
    </select>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:247-342 — pkg_open_cursor.proc_process_dynamic_query.insertAuditLog -->
    <insert id="insertAuditLog">
        INSERT INTO audit_log(log_time, operation, sql_text, user_name) VALUES (CURRENT_TIMESTAMP, 'DYNAMIC_QUERY', #{vSql, jdbcType=VARCHAR, javaType=String}, "USER")
    </insert>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:247-342 — pkg_open_cursor.proc_process_dynamic_query.selectProcProcessDynamicQuery -->
    <select id="selectProcProcessDynamicQuery" parameterType="string" resultType="java.util.LinkedHashMap">
        SELECT id, name, amount, status, create_time FROM ${pTableName}
        <where>
            <if test="pWhereClause != null">
                AND ${pWhereClause}
            </if>
        </where>
        <if test="pOrderBy != null">
            ORDER BY ${pOrderBy}
        </if>
    </select>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:247-342 — pkg_open_cursor.proc_process_dynamic_query.updateProcProcessDynamicQuery -->
    <update id="updateProcProcessDynamicQuery">
        UPDATE ${pTableName} SET status = 'PROCESSING', process_time = CURRENT_TIMESTAMP WHERE id = #{vRecId}
    </update>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:247-342 — pkg_open_cursor.proc_process_dynamic_query.updateProcProcessDynamicQuery_1 -->
    <update id="updateProcProcessDynamicQuery_1">
        UPDATE ${pTableName} SET status = 'TIMEOUT', retry_count = coalesce(retry_count,0)+1 WHERE id = #{vRecId}
    </update>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:247-342 — pkg_open_cursor.proc_process_dynamic_query.insertArchiveTable -->
    <insert id="insertArchiveTable">
        INSERT INTO archive_table (id, name, amount, status, archived_time) VALUES (#{vRecId, jdbcType=INTEGER, javaType=Integer}, #{vRecName, jdbcType=VARCHAR, javaType=String}, #{vRecValue, jdbcType=NUMERIC, javaType=java.math.BigDecimal}, #{vRecStatus, jdbcType=VARCHAR, javaType=String}, CURRENT_TIMESTAMP)
    </insert>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:247-342 — pkg_open_cursor.proc_process_dynamic_query.deleteProcProcessDynamicQuery -->
    <delete id="deleteProcProcessDynamicQuery">
        DELETE FROM ${pTableName} WHERE id = #{vRecId}
    </delete>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:247-342 — pkg_open_cursor.proc_process_dynamic_query.insertExceptionLog -->
    <insert id="insertExceptionLog">
        INSERT INTO exception_log(exception_time, record_id, exception_type, detail) VALUES (CURRENT_TIMESTAMP, #{vRecId, jdbcType=INTEGER, javaType=Integer}, 'UNKNOWN_STATUS', #{vRecStatus, jdbcType=VARCHAR, javaType=String})
    </insert>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:247-342 — pkg_open_cursor.proc_process_dynamic_query.insertErrorLog -->
    <insert id="insertErrorLog">
        INSERT INTO error_log(error_time, context, 0, '') VALUES (CURRENT_TIMESTAMP, 'Record ID=' || #{vRecId, jdbcType=INTEGER, javaType=Integer}, 0, '')
    </insert>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:247-342 — pkg_open_cursor.proc_process_dynamic_query.insertPerformanceLog -->
    <insert id="insertPerformanceLog">
        INSERT INTO performance_log(log_time, procedure_name, rows_processed, elapsed_ms) VALUES (CURRENT_TIMESTAMP, 'proc_process_dynamic_query', #{vRowCount, jdbcType=INTEGER, javaType=Integer}, EXTRACT(EPOCH FROM (CURRENT_TIMESTAMP - #{vStartTime, jdbcType=TIMESTAMP, javaType=java.sql.Timestamp})) * 1000)
    </insert>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:344-381 — pkg_open_cursor.proc_paginated_query.selectProcPaginatedQuery -->
    <select id="selectProcPaginatedQuery" resultType="java.util.LinkedHashMap">
        SELECT t.*, COUNT(*) OVER () AS total_rows FROM ( SELECT emp_id as employee_id , emp_name as employee_name , dept_id as department_id , base_salary as salary, hire_date, ROW_NUMBER() OVER (ORDER BY employee_id) AS rn FROM employees WHERE status = 'ACTIVE' ) t WHERE rn &gt; #{vOffset, jdbcType=INTEGER, javaType=Integer} AND rn &lt;= #{vOffset, jdbcType=INTEGER, javaType=Integer} + #{pPageSize, jdbcType=INTEGER, javaType=Integer} ORDER BY rn
    </select>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:344-381 — pkg_open_cursor.proc_paginated_query.selectProcPaginatedQuery_1 -->
    <select id="selectProcPaginatedQuery_1" parameterType="integer" resultType="java.util.LinkedHashMap">
        SELECT COUNT(*) AS total_count, COUNT(DISTINCT department_id) AS dept_count, ROUND(AVG(salary), 2) AS avg_salary, MIN(salary) AS min_salary, MAX(salary) AS max_salary FROM employees WHERE status = 'ACTIVE'
    </select>

</mapper>