// ===== FILE: CursorLifecycleMapper.xml =====
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.CursorLifecycleMapper">

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:704-715 — pkg_cursor_lifecycle.proc_get_raw_cursor.selectProcGetRawCursor -->
    <select id="selectProcGetRawCursor" parameterType="integer" resultType="java.util.LinkedHashMap">
        select employee_id , employee_name , salary , department_id , hire_date from employees where department_id = #{pDeptId} and status = 'ACTIVE' order by salary desc
    </select>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:717-749 — pkg_cursor_lifecycle.proc_enhance_cursor.insertProcEnhanceCursor -->
    <insert id="insertProcEnhanceCursor">
        INSERT INTO ${vTemp} VALUES ( #{vId}, #{vName}, #{vSalary}, #{vDeptId}, #{vHireDate}, EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM #{vHireDate}), CASE WHEN #{vSalary} &gt; 80000 THEN 'SENIOR' ELSE 'JUNIOR' END, CASE WHEN EXTRACT(YEAR FROM CURRENT_DATE) - EXTRACT(YEAR FROM #{vHireDate}) &gt;= 2 THEN 1 ELSE 0 END )
    </insert>

</mapper>

