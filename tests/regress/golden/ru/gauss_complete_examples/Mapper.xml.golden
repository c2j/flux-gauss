    </insert>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:403-490 — pkg_dynamic_for_loop.proc_dynamic_for_processing.insertPerformanceLog -->
    <insert id="insertPerformanceLog">
