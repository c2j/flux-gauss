    </update>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:403-490 — pkg_dynamic_for_loop.proc_dynamic_for_processing.updateProcDynamicForProcessing_1 -->
    <update id="updateProcDynamicForProcessing_1">
        UPDATE ${pTableName} SET status = #{arg1}, update_time = CURRENT_TIMESTAMP, update_count = coalesce(update_count,0)+1 WHERE id = #{vPkId}
    </update>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:403-490 — pkg_dynamic_for_loop.proc_dynamic_for_processing.updateProcDynamicForProcessing_2 -->
    <update id="updateProcDynamicForProcessing_2">
        UPDATE ${pTableName} SET is_deleted = #{arg1}, delete_time = CURRENT_TIMESTAMP WHERE id = #{vPkId}
    </update>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:403-490 — pkg_dynamic_for_loop.proc_dynamic_for_processing.insertScanLog -->
    <insert id="insertScanLog">
