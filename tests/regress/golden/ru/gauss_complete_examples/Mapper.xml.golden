    </insert>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:403-490 — pkg_dynamic_for_loop.proc_dynamic_for_processing.selectProcDynamicForProcessing -->
    <select id="selectProcDynamicForProcessing" resultType="java.util.LinkedHashMap">
        SELECT #{expr_0} FROM ${pTableName}
        <where>
            <if test="pWhereClause != null">
                AND ${pWhereClause}
            </if>
        </where>
        <if test="pOrderBy != null">
            ORDER BY ${pOrderBy}
        </if>
    </select>

    <!-- Source: {FIXTURES_ROOT}/gauss_complete_examples.sql:403-490 — pkg_dynamic_for_loop.proc_dynamic_for_processing.insertProcDynamicForProcessing -->
