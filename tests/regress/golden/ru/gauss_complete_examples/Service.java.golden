    public Object stringSplit(String pString, String pDelimiter) {
        List<String> vArray = null;
        Integer vEnd = 0;
        Integer vIdx = 1;
        Integer vStart = 1;
        if (pString == null) {
            return vArray;
        }
        vEnd = String.valueOf(pString).indexOf(String.valueOf(pDelimiter), Math.max(0, (vStart) - 1)) + 1;
        while (vEnd > 0) {
            // CALL v_array(vIdx)
            // SQL: := trim ( SUBSTR ( p_string , v_start , v_end - v_start ) )
            vIdx = vIdx + 1;
            vStart = vEnd + pDelimiter.length();
            vEnd = String.valueOf(pString).indexOf(String.valueOf(pDelimiter), Math.max(0, (vStart) - 1)) + 1;
        }
        // CALL v_array(vIdx)
        // SQL: := trim ( SUBSTR ( p_string , v_start ) )
        return vArray;
    }

