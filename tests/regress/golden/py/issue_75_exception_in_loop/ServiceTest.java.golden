    void test_pIssue75DeadReturn_success() {
        AtomicReference<String> pOSucceed = new AtomicReference<>(null);
        var _rowTmpl = new java.util.HashMap<String,Object>();
        when(issue75ExceptionInLoopMapper.deleteTIssue75()).thenReturn(1);
        when(issue75ExceptionInLoopMapper.insertTIssue75(any())).thenReturn(1);
        service.pIssue75DeadReturn(pOSucceed);
        verify(issue75ExceptionInLoopMapper, atLeast(0)).deleteTIssue75();
    }
}