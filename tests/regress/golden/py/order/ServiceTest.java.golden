class OrderServiceTest {

    @Mock
    private OrderMapper orderMapper;

    @InjectMocks
    private OrderService service;

    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_createOrder_success() {
        Long pUserId = 1L;
        Long pProductId = 1L;
        Integer pQty = 5;
        var _rowTmpl = new java.util.HashMap<String,Object>(); _rowTmpl.put("product_id", 1); _rowTmpl.put("qty", 5);
        when(orderMapper.insertTOrders(any(), any(), any())).thenReturn(1);
        { var m = new java.util.HashMap<String,Object>(); m.put("product_id", 1); m.put("qty", 5); m.putAll(_rowTmpl); when(orderMapper.selectTOrders(any())).thenReturn(m).thenReturn(null); }
        when(orderMapper.updateTOrders(any())).thenReturn(1);
        { var m = new java.util.HashMap<String,Object>(); m.put("product_name", "test"); m.putAll(_rowTmpl); when(orderMapper.selectGetOrderDetail(any())).thenReturn(java.util.List.of(m)).thenReturn(java.util.List.of()); }
        when(orderMapper.updateTOrders_1(any())).thenReturn(1);
        service.createOrder(pUserId, pProductId, pQty);
        verify(orderMapper, atLeast(0)).insertTOrders(any(), any(), any());
    }

