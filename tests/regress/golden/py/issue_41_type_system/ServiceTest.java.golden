    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procTransfer_throwsBusinessException() {
        org.junit.jupiter.api.Assumptions.assumeTrue(false, "auto-generated error test requires domain-specific test data");
        Long pFromAccount = 100L;
        Long pToAccount = 100L;
        java.math.BigDecimal pAmount = new java.math.BigDecimal("99.99");
        java.sql.Date pTransferDate = java.sql.Date.valueOf("2024-01-01");
        Boolean pIsUrgent = true;
        AtomicReference<java.math.BigDecimal> pNewBalance = new AtomicReference<>(null);
        AtomicReference<String> pStatus = new AtomicReference<>(null);
        when(issue41TypeSystemMapper.selectTIssue41Account(any(), any(), any(), any(), any())).thenReturn(java.math.BigDecimal.ZERO);
        when(issue41TypeSystemMapper.updateTIssue41Account(any(), any(), any(), any(), any(), any())).thenReturn(1);
        when(issue41TypeSystemMapper.selectTIssue41Account_1(any(), any(), any(), any(), any())).thenReturn(java.math.BigDecimal.ZERO);
        when(issue41TypeSystemMapper.updateTIssue41Account_1(any(), any(), any(), any(), any(), any())).thenReturn(1);
        assertThrows(BusinessException.class, () -> {
            service.procTransfer(pFromAccount, pToAccount, pAmount, pTransferDate, pIsUrgent, pNewBalance, pStatus);
        });
    }

