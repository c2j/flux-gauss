<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.Issue48LongComparetoStringMapper">

    <!-- Source: issue_48_long_compareto_string.sql:70-70 — pkg_issue48_compare.proc_check_pro_id.selectDualCount -->
    <select id="selectDualCount" parameterType="long" resultType="int">
        select COUNT(*)
        from DUAL
                LIMIT 1
    </select>

