package com.example.demo.service;

import com.example.demo.exception.BusinessException;
import com.example.demo.mapper.Issue47LongParseStringMapper;
import java.util.concurrent.atomic.AtomicReference;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
public class Issue47LongParseStringService {
    private static final Logger log = LoggerFactory.getLogger(Issue47LongParseStringService.class);

    private final Issue47LongParseStringMapper issue47LongParseStringMapper;

    public Issue47LongParseStringService(Issue47LongParseStringMapper issue47LongParseStringMapper) {
        this.issue47LongParseStringMapper = issue47LongParseStringMapper;
    }
    // Source: pkg_issue47_types.proc_set_step_no (PROCEDURE) — issue_47_long_parse_string.sql:52-80
    public void procSetStepNo(Integer pSeq, Integer pSubSeq, AtomicReference<String> pStepNo) {
        String vStepNo = null;
        pStepNo.set(null);
        if (pSeq == 1) {
            if (pSubSeq == 1) {
                vStepNo = "1.1";
            } else {
                vStepNo = "1." + pSubSeq;
            }
        } else if (pSeq == 2) {
            if (pSubSeq == 5) {
                vStepNo = "2.5.1";
            } else if (pSubSeq == 7) {
                vStepNo = "2.7";
            } else if (pSubSeq == 8) {
                vStepNo = "2.8";
            } else {
                vStepNo = "2." + pSubSeq;
            }
        } else {
            vStepNo = pSeq + ".0";
        }
        pStepNo.set(String.valueOf(vStepNo));
    }

    // Source: pkg_issue47_types.proc_process_id (PROCEDURE) — issue_47_long_parse_string.sql:88-106
    public void procProcessId(String pType, AtomicReference<String> pProId) {
        String vProId = null;
        pProId.set(null);
        if (java.util.Objects.equals(pType, "NEW")) {
            vProId = "6034";
        } else if (java.util.Objects.equals(pType, "OLD")) {
            vProId = "5821";
        } else {
            vProId = "9999";
        }
        vProId = vProId + ",8208,9,354,360,370,6034,5821";
        pProId.set(String.valueOf(vProId));
    }

    // Source: pkg_issue47_types.proc_correct_varchar (PROCEDURE) — issue_47_long_parse_string.sql:112-123
    public void procCorrectVarchar(String pLabel, AtomicReference<String> pValue) {
        String vLabel = null;
        pValue.set(null);
        vLabel = pLabel;
        if (String.valueOf(vLabel).length() == 0) {
            vLabel = "DEFAULT";
        }
        pValue.set(String.valueOf(vLabel));
    }
}