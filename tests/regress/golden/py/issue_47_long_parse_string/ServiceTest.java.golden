    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procSetStepNo_success() {
        Integer pSeq = 1;
        Integer pSubSeq = 1;
        AtomicReference<String> pStepNo = new AtomicReference<>(null);
        service.procSetStepNo(pSeq, pSubSeq, pStepNo);
    }

    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procProcessId_success() {
        String pType = "test_pType";
        AtomicReference<String> pProId = new AtomicReference<>(null);
        service.procProcessId(pType, pProId);
    }

    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_procCorrectVarchar_success() {
        String pLabel = "test_pLabel";
        AtomicReference<String> pValue = new AtomicReference<>(null);
        service.procCorrectVarchar(pLabel, pValue);
