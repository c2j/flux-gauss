package com.example.demo.service;

import com.example.demo.exception.BusinessException;
import com.example.demo.mapper.Issue45ExceptionHandlingMapper;
import java.util.concurrent.atomic.AtomicReference;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
public class Issue45ExceptionHandlingService {
    private static final Logger log = LoggerFactory.getLogger(Issue45ExceptionHandlingService.class);

    private final Issue45ExceptionHandlingMapper issue45ExceptionHandlingMapper;

    public Issue45ExceptionHandlingService(Issue45ExceptionHandlingMapper issue45ExceptionHandlingMapper) {
        this.issue45ExceptionHandlingMapper = issue45ExceptionHandlingMapper;
    }
    // Source: pkg_issue45_exception.proc_link_etf_repay (PROCEDURE) — issue_45_exception_handling.sql:66-99
    public void procLinkEtfRepay(String pSecurityCode, AtomicReference<String> pOSucceed, AtomicReference<String> pOSecurityId) {
        String vSecurityId = null;
        try {
            pOSucceed.set(null);
            pOSecurityId.set(null);
            vSecurityId = issue45ExceptionHandlingMapper.selectTIssue45Security(pSecurityCode);
            if (vSecurityId == null) {
                // SqlStatement
                pOSucceed.set("FOUND_BAK");
                pOSecurityId.set(String.valueOf(vSecurityId));
            }
            pOSucceed.set("FOUND_MAIN");
            pOSecurityId.set(String.valueOf(vSecurityId));
        } catch (Exception e) { // EXCEPTION handlers — src: issue_45_exception_handling.sql:66
            pOSucceed.set("ERROR: 证券代码查询异常");
            pOSecurityId.set("");
        }
    }

    // Source: pkg_issue45_exception.proc_simple_exception (PROCEDURE) — issue_45_exception_handling.sql:104-118
    public void procSimpleException(String pSecurityCode, AtomicReference<String> pResult) {
        String vId = null;
        try {
            pResult.set(null);
            vId = issue45ExceptionHandlingMapper.selectTIssue45Security_1(pSecurityCode);
            pResult.set("OK: " + vId);
        } catch (Exception e) { // EXCEPTION handlers — src: issue_45_exception_handling.sql:104
            pResult.set("ERROR: " + e.getMessage());
        }
    }

    // Source: pkg_issue45_exception.proc_nested_exception (PROCEDURE) — issue_45_exception_handling.sql:123-144
    public void procNestedException(String pCode, AtomicReference<String> pMsg) {
        String vValue = null;
        try {
            pMsg.set(null);
            try {
                vValue = issue45ExceptionHandlingMapper.selectTIssue45Security_2(pCode);
                pMsg.set("VALUE: " + vValue);
            } catch (Exception e) { // no_data_found; OTHERS
                // WHEN no_data_found
                pMsg.set("NOT_FOUND: " + pCode);
                // WHEN OTHERS
                pMsg.set("SYSTEM_ERROR: " + e.getMessage());
            }
        } catch (Exception e) { // EXCEPTION handlers — src: issue_45_exception_handling.sql:123
            pMsg.set("OUTER_ERROR");
        }
    }
}