<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.Issue45ExceptionHandlingMapper">

    <!-- Source: issue_45_exception_handling.sql:74-74 — pkg_issue45_exception.proc_link_etf_repay.selectTIssue45Security -->
    <select id="selectTIssue45Security" parameterType="string" resultType="string">
        select t.security_id
        from t_issue45_security AS t
        where t.security_name = #{pSecurityCode, jdbcType=VARCHAR, javaType=String}
                LIMIT 1
    </select>

    <!-- Source: issue_45_exception_handling.sql:110-110 — pkg_issue45_exception.proc_simple_exception.selectTIssue45Security -->
    <select id="selectTIssue45Security" parameterType="string" resultType="string">
        select t.security_id
        from t_issue45_security AS t
        where t.security_name = #{pSecurityCode, jdbcType=VARCHAR, javaType=String}
                LIMIT 1
    </select>

    <!-- Source: issue_45_exception_handling.sql:130-130 — pkg_issue45_exception.proc_nested_exception.selectTIssue45Security -->
    <select id="selectTIssue45Security" parameterType="string" resultType="string">
        select t.security_name
        from t_issue45_security AS t
        where t.security_id = #{pCode, jdbcType=VARCHAR, javaType=String}
                LIMIT 1
    </select>

</mapper>