    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_prcBindIndex_success() {
        String pSeqno = "1";
        String pFundId = "test_pFundId";
        var _rowTmpl = new java.util.HashMap<String,Object>();
        { var m = new java.util.HashMap<String,Object>(); m.put("xmlforest", 1); m.putAll(_rowTmpl); when(issue144BindIndexMapper.selectPrcBindIndex(any())).thenReturn(m).thenReturn(null); }
        { var m = new java.util.HashMap<String,Object>(); m.put("xmlforest", 1); m.putAll(_rowTmpl); when(issue144BindIndexMapper.selectPrcBindIndex_1(any(), any())).thenReturn(m).thenReturn(null); }
        service.prcBindIndex(pSeqno, pFundId);
    }
}