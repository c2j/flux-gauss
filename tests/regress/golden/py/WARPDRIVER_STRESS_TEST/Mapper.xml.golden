    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:606-606 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateOrders_26 -->
    <update id="updateOrders_26">
