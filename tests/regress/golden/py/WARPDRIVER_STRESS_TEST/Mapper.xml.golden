        from accounts
        where account_id = #{pAccountId, jdbcType=BIGINT, javaType=Long}
                LIMIT 1
    </select>

    <select id="selectNextval" resultType="long">
            SELECT nextval(#{seqName, jdbcType=VARCHAR}) AS val
    </select>

</mapper>