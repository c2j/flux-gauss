        from accounts
        where account_id = #{pAccountId, jdbcType=BIGINT, javaType=Long}
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:818-818 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.updateAccounts_1 -->
    <update id="updateAccounts_1">
        update accounts set balance = balance - #{pAmount, jdbcType=NUMERIC, javaType=java.math.BigDecimal}, pre_amount = #{pAmount, jdbcType=NUMERIC, javaType=java.math.BigDecimal} where account_id = #{pAccountId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:825-825 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.insertAccountJournal -->
    <insert id="insertAccountJournal">
        insert into account_journal (account_id, dr_amount, cr_amount, remark) values (#{pAccountId, jdbcType=BIGINT, javaType=Long}, #{pAmount, jdbcType=NUMERIC, javaType=java.math.BigDecimal}, 0, 'PRE_DEBIT')
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:832-832 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.updateAccounts_2 -->
    <update id="updateAccounts_2">
