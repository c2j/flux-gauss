          payment_id,
          pay_amount,
          pay_channel,
          pay_time
        from payments
        where customer_id = #{pCustomerId, jdbcType=BIGINT, javaType=Long}
          AND pay_status = 'SUCCESS'
        order by pay_time desc
        limit 100
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:792-792 — PKG_WARPDRIVER_STRESS_TEST.fn_multi_cursor_return.selectOrdersCount -->
    <select id="selectOrdersCount" parameterType="long" resultType="int">
