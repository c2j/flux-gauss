        where customer_id = #{pCustomerId, jdbcType=BIGINT, javaType=Long}
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:793-793 — PKG_WARPDRIVER_STRESS_TEST.fn_multi_cursor_return.selectPaymentsCount -->
    <select id="selectPaymentsCount" parameterType="long" resultType="int">
        select COUNT(*)
        from payments
        where customer_id = #{pCustomerId, jdbcType=BIGINT, javaType=Long}
          AND pay_status = 'SUCCESS'
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:812-812 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.selectAccounts -->
    <select id="selectAccounts" resultType="java.math.BigDecimal">
