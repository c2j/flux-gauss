    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:545-545 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateOrders_17 -->
    <update id="updateOrders_17">
        update orders set status = 'CANCELLED', cancel_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:553-553 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateOrders_18 -->
    <update id="updateOrders_18">
        update orders set retry_count = #{vRetry, jdbcType=INTEGER, javaType=Integer}, last_retry = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:557-557 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateOrders_19 -->
    <update id="updateOrders_19">
        update orders set status = 'EXPIRED' where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:566-566 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateOrders_20 -->
    <update id="updateOrders_20">
        update orders set status = 'SHIPPED', ship_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:571-571 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateOrders_21 -->
    <update id="updateOrders_21">
        update orders set status = 'REFUNDING', refund_apply_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:580-580 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateOrders_22 -->
    <update id="updateOrders_22">
        update orders set status = 'COMPLETED', complete_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:585-585 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateOrders_23 -->
    <update id="updateOrders_23">
        update orders set status = 'REFUNDING', refund_apply_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:594-594 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateOrders_24 -->
    <update id="updateOrders_24">
        update orders set status = 'REFUNDED', refund_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:600-600 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateOrders_25 -->
    <update id="updateOrders_25">
