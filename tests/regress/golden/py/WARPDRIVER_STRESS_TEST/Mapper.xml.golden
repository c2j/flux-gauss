    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:847-847 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.insertSpSavepointHell -->
    <insert id="insertSpSavepointHell">
        INSERT INTO notifications1(${pAccountId},
            notify_type,
            content)
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:857-857 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.selectAccounts_1 -->
    <select id="selectAccounts_1" resultType="object">
