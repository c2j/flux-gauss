    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:618-618 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.selectOrders_2 -->
    <select id="selectOrders_2" resultType="string">
