    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:833-833 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.insertRiskEvents -->
    <insert id="insertRiskEvents">
        insert into risk_events (account_id, event_type, event_time) values (#{pAccountId, jdbcType=BIGINT, javaType=Long}, 'OVERDRAW', current_timestamp)
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:843-843 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.insertNotifications -->
    <insert id="insertNotifications">
