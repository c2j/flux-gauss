    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:718-718 — PKG_WARPDRIVER_STRESS_TEST.fn_recursive_tree_cleanup.deleteTreeAttributes -->
    <delete id="deleteTreeAttributes">
        delete from tree_attributes where node_id = #{vChildId, jdbcType=BIGINT, javaType=Long}
    </delete>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:719-719 — PKG_WARPDRIVER_STRESS_TEST.fn_recursive_tree_cleanup.deleteTreeNodes -->
    <delete id="deleteTreeNodes">
