<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.WarpdriverStressTestMapper">

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:112-112 — PKG_WARPDRIVER_STRESS_TEST.sp_autonomous_audit.insertAuditTrail -->
    <insert id="insertAuditTrail" parameterType="string">
        insert into audit_trail (action_code, detail_info, created_at, session_id) values (#{pAction, jdbcType=VARCHAR, javaType=String}, #{pDetail, jdbcType=VARCHAR, javaType=String}, current_timestamp, pg_backend_pid())
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:130-130 — PKG_WARPDRIVER_STRESS_TEST.fn_dynamic_executor.updateFnDynamicExecutor -->
    <update id="updateFnDynamicExecutor">
        ${pSql}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:162-162 — PKG_WARPDRIVER_STRESS_TEST.sp_main_orchestrator.selectSpMainOrchestrator_2 -->
    <select id="selectSpMainOrchestrator_2" resultType="java.util.LinkedHashMap">
        select
          order_id,
          total_amount,
          status
        from orders
        where biz_date = #{vDate, jdbcType=DATE, javaType=java.sql.Date}
          AND status in ('PENDING', 'PROCESSING')
        order by priority desc
        limit g_batch_size
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:169-169 — PKG_WARPDRIVER_STRESS_TEST.sp_main_orchestrator.selectSpMainOrchestrator_3 -->
    <select id="selectSpMainOrchestrator_3" resultType="java.util.LinkedHashMap">
        select
          order_id,
          total_amount,
          status
        from orders
        where biz_date = #{vDate, jdbcType=DATE, javaType=java.sql.Date}
        order by create_time
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:197-197 — PKG_WARPDRIVER_STRESS_TEST.sp_main_orchestrator.updateOrders_1 -->
    <update id="updateOrders_1">
        update orders set status = 'PROCESSING', process_time = current_timestamp where order_id = #{vRec.order_id}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:256-256 — PKG_WARPDRIVER_STRESS_TEST.sp_main_orchestrator.insertErrorLog_1 -->
    <insert id="insertErrorLog_1">
        insert into error_log (log_id, order_id, err_msg, created_at) values (#{pLogId, jdbcType=BIGINT, javaType=Long}, #{vRec.order_id}, 'NEGATIVE_AMOUNT', current_timestamp)
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:267-267 — PKG_WARPDRIVER_STRESS_TEST.sp_main_orchestrator.insertOrderItemSnapshot_1 -->
    <insert id="insertOrderItemSnapshot_1">
        insert into order_item_snapshot (log_id, item_data, created_at) values (#{pLogId, jdbcType=BIGINT, javaType=Long}, to_jsonb(#{vItemTab}(#{i, jdbcType=INTEGER, javaType=Integer})), current_timestamp)
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:306-306 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_cleanup_master.insertDistributedLocks -->
    <insert id="insertDistributedLocks">
        insert into distributed_locks (lock_key, holder_id, acquired_at) values (#{vLockKey, jdbcType=VARCHAR, javaType=String}, #{vConnId, jdbcType=BIGINT, javaType=Long}, current_timestamp)
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:310-310 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_cleanup_master.selectOrders -->
    <select id="selectOrders" parameterType="long" resultType="java.math.BigDecimal">
        select total_amount
        from orders
        where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:323-323 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_cleanup_master.updateOrders_2 -->
    <update id="updateOrders_2" parameterType="long">
        update orders set version = version + 1, update_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long} AND version = (select version from orders where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long})
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:333-333 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_cleanup_master.updateAccounts -->
    <update id="updateAccounts">
        update accounts set balance = balance - #{vTempAmt, jdbcType=NUMERIC, javaType=java.math.BigDecimal} where account_id = (select account_id from orders where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long})
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:336-336 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_cleanup_master.insertTransactionLog -->
    <insert id="insertTransactionLog">
        insert into transaction_log (order_id, amount, tx_type, tx_time) values (#{pOrderId, jdbcType=BIGINT, javaType=Long}, #{vTempAmt, jdbcType=NUMERIC, javaType=java.math.BigDecimal}, 'DEBIT', current_timestamp)
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:343-343 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_cleanup_master.deleteDistributedLocks -->
    <delete id="deleteDistributedLocks">
        delete from distributed_locks where lock_key = #{vLockKey, jdbcType=VARCHAR, javaType=String}
    </delete>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:369-369 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_loop_purge.deleteOperationLogs -->
    <delete id="deleteOperationLogs">
        delete from operation_logs where create_time &lt; #{vCutoff, jdbcType=TIMESTAMP, javaType=java.sql.Timestamp} AND log_id in (select log_id from operation_logs where create_time &lt; #{vCutoff, jdbcType=TIMESTAMP, javaType=java.sql.Timestamp} limit #{vBatch, jdbcType=INTEGER, javaType=Integer})
    </delete>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:414-414 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_skip_logic.selectSpGotoSkipLogic_4 -->
    <select id="selectSpGotoSkipLogic_4" resultType="java.util.LinkedHashMap">
        select
          region_code,
          COUNT(*) AS cnt,
          SUM(settle_amount) AS amt,
          AVG(fee_rate) AS avg_fee
        from settlement
        where settle_date = #{vDate, jdbcType=DATE, javaType=java.sql.Date}
        group by region_code
        having COUNT(*) &gt; 10
        order by amt desc
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:431-431 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_skip_logic.selectSettlementCount -->
    <select id="selectSettlementCount" resultType="string">
        select '总计:' || COUNT(*) || '笔,金额:' || coalesce(SUM(settle_amount), 0)
        from settlement
        where settle_date = #{vDate, jdbcType=DATE, javaType=java.sql.Date}
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:442-442 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.selectSpGotoDeepEscape_9 -->
    <select id="selectSpGotoDeepEscape_9" parameterType="long" resultType="java.util.LinkedHashMap">
        select
          order_id,
          customer_id,
          order_type
        from bulk_orders
        where batch_id = #{pBatchId, jdbcType=BIGINT, javaType=Long}
          AND process_flag = 'N'
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:442-442 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.selectSpGotoDeepEscape_10 -->
    <select id="selectSpGotoDeepEscape_10" resultType="java.util.LinkedHashMap">
        select 1
        from black_list
        where customer_id = #{mainRec.customer_id}
          AND active = 'Y'
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:460-460 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.updateBulkOrders_4 -->
    <update id="updateBulkOrders_4">
        update bulk_orders set process_flag = 'BLACKLIST', process_time = current_timestamp where order_id = #{mainRec.order_id}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:460-460 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.selectSpGotoDeepEscape_11 -->
    <select id="selectSpGotoDeepEscape_11" resultType="java.util.LinkedHashMap">
        select
          rule_id,
          threshold
        from risk_rules
        where rule_type = #{mainRec.order_type}
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:472-472 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.selectCustomerRisk_1 -->
    <select id="selectCustomerRisk_1" resultType="int">
        select risk_score
        from customer_risk
        where customer_id = #{mainRec.customer_id}
          AND rule_id = #{riskRec.rule_id}
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:477-477 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.updateBulkOrders_5 -->
    <update id="updateBulkOrders_5">
        update bulk_orders set process_flag = 'RISK_REJECT', reject_reason = 'RULE_' || #{riskRec.rule_id} where order_id = #{mainRec.order_id}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:477-477 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.selectSpGotoDeepEscape_12 -->
    <select id="selectSpGotoDeepEscape_12" resultType="java.util.LinkedHashMap">
        select
          product_id,
          required_qty
        from order_items
        where order_id = #{mainRec.order_id}
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:494-494 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.selectInventory_1 -->
    <select id="selectInventory_1" resultType="int">
        select available_qty
        from inventory
        where product_id = #{stockRec.product_id}
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:497-497 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.updateBulkOrders_6 -->
    <update id="updateBulkOrders_6">
        update bulk_orders set process_flag = 'NO_STOCK', reject_reason = 'PROD_' || #{stockRec.product_id} where order_id = #{mainRec.order_id}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:505-505 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.updateBulkOrders_7 -->
    <update id="updateBulkOrders_7">
        update bulk_orders set process_flag = 'PASSED', process_time = current_timestamp where order_id = #{mainRec.order_id}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:528-528 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateOrders_15 -->
    <update id="updateOrders_15">
        update orders set status = 'PENDING', submit_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:540-540 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateOrders_16 -->
