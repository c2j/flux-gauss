    </delete>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:777-777 — PKG_WARPDRIVER_STRESS_TEST.fn_multi_cursor_return.selectFnMultiCursorReturn_14 -->
    <select id="selectFnMultiCursorReturn_14" parameterType="long" resultType="java.util.LinkedHashMap">
        select
          order_id,
          total_amount,
          status,
          create_time
        from orders
        where customer_id = #{pCustomerId, jdbcType=BIGINT, javaType=Long}
        order by create_time desc
        limit 100
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:784-784 — PKG_WARPDRIVER_STRESS_TEST.fn_multi_cursor_return.selectFnMultiCursorReturn_15 -->
    <select id="selectFnMultiCursorReturn_15" parameterType="long" resultType="java.util.LinkedHashMap">
