<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.WarpdriverStressTestMapper">

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:112-112 — PKG_WARPDRIVER_STRESS_TEST.sp_autonomous_audit.insertSpAutonomousAudit -->
    <insert id="insertSpAutonomousAudit" parameterType="string">
        insert into audit_trail (action_code, detail_info, created_at, session_id) values (#{pAction, jdbcType=VARCHAR, javaType=String}, #{pDetail, jdbcType=VARCHAR, javaType=String}, current_timestamp, pg_backend_pid())
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:130-130 — PKG_WARPDRIVER_STRESS_TEST.fn_dynamic_executor.updateFnDynamicExecutor -->
    <update id="updateFnDynamicExecutor">
        ${pSql}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:162-162 — PKG_WARPDRIVER_STRESS_TEST.sp_main_orchestrator.selectSpMainOrchestrator -->
    <select id="selectSpMainOrchestrator" resultType="java.util.LinkedHashMap">
        select
          order_id,
          total_amount,
          status
        from orders
        where biz_date = #{vDate, jdbcType=DATE, javaType=java.sql.Date}
          AND status in ('PENDING', 'PROCESSING')
        order by priority desc
        limit g_batch_size
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:169-169 — PKG_WARPDRIVER_STRESS_TEST.sp_main_orchestrator.selectSpMainOrchestrator_1 -->
    <select id="selectSpMainOrchestrator_1" resultType="java.util.LinkedHashMap">
        select
          order_id,
          total_amount,
          status
        from orders
        where biz_date = #{vDate, jdbcType=DATE, javaType=java.sql.Date}
        order by create_time
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:197-197 — PKG_WARPDRIVER_STRESS_TEST.sp_main_orchestrator.updateSpMainOrchestrator -->
    <update id="updateSpMainOrchestrator">
        update orders set status = 'PROCESSING', process_time = current_timestamp where order_id = #{vRec.order_id}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:256-256 — PKG_WARPDRIVER_STRESS_TEST.sp_main_orchestrator.insertSpMainOrchestrator -->
    <insert id="insertSpMainOrchestrator">
        insert into error_log (log_id, order_id, err_msg, created_at) values (#{pLogId, jdbcType=BIGINT, javaType=Long}, #{vRec.order_id}, 'NEGATIVE_AMOUNT', current_timestamp)
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:267-267 — PKG_WARPDRIVER_STRESS_TEST.sp_main_orchestrator.insertSpMainOrchestrator_1 -->
    <insert id="insertSpMainOrchestrator_1">
        insert into order_item_snapshot (log_id, item_data, created_at) values (#{pLogId, jdbcType=BIGINT, javaType=Long}, to_jsonb(#{vItemTab}(#{i, jdbcType=INTEGER, javaType=Integer})), current_timestamp)
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:306-306 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_cleanup_master.insertSpGotoCleanupMaster -->
    <insert id="insertSpGotoCleanupMaster">
        insert into distributed_locks (lock_key, holder_id, acquired_at) values (#{vLockKey, jdbcType=VARCHAR, javaType=String}, #{vConnId, jdbcType=BIGINT, javaType=Long}, current_timestamp)
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:310-310 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_cleanup_master.selectSpGotoCleanupMaster -->
    <select id="selectSpGotoCleanupMaster" parameterType="long" resultType="java.math.BigDecimal">
        select total_amount
        from orders
        where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:323-323 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_cleanup_master.updateSpGotoCleanupMaster -->
    <update id="updateSpGotoCleanupMaster" parameterType="long">
        update orders set version = version + 1, update_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long} AND version = (select version from orders where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long})
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:333-333 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_cleanup_master.updateSpGotoCleanupMaster_1 -->
    <update id="updateSpGotoCleanupMaster_1">
        update accounts set balance = balance - #{vTempAmt, jdbcType=NUMERIC, javaType=java.math.BigDecimal} where account_id = (select account_id from orders where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long})
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:336-336 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_cleanup_master.insertSpGotoCleanupMaster_1 -->
    <insert id="insertSpGotoCleanupMaster_1">
        insert into transaction_log (order_id, amount, tx_type, tx_time) values (#{pOrderId, jdbcType=BIGINT, javaType=Long}, #{vTempAmt, jdbcType=NUMERIC, javaType=java.math.BigDecimal}, 'DEBIT', current_timestamp)
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:343-343 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_cleanup_master.deleteSpGotoCleanupMaster -->
    <delete id="deleteSpGotoCleanupMaster">
        delete from distributed_locks where lock_key = #{vLockKey, jdbcType=VARCHAR, javaType=String}
    </delete>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:369-369 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_loop_purge.deleteSpGotoLoopPurge -->
    <delete id="deleteSpGotoLoopPurge">
        delete from operation_logs where create_time &lt; #{vCutoff, jdbcType=TIMESTAMP, javaType=java.sql.Timestamp} AND log_id in (select log_id from operation_logs where create_time &lt; #{vCutoff, jdbcType=TIMESTAMP, javaType=java.sql.Timestamp} limit #{vBatch, jdbcType=INTEGER, javaType=Integer})
    </delete>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:414-414 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_skip_logic.selectSpGotoSkipLogic -->
    <select id="selectSpGotoSkipLogic" resultType="java.util.LinkedHashMap">
        select
          region_code,
          COUNT(*) AS cnt,
          SUM(settle_amount) AS amt,
          AVG(fee_rate) AS avg_fee
        from settlement
        where settle_date = #{vDate, jdbcType=DATE, javaType=java.sql.Date}
        group by region_code
        having COUNT(*) &gt; 10
        order by amt desc
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:431-431 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_skip_logic.selectSpGotoSkipLogic_1 -->
    <select id="selectSpGotoSkipLogic_1" resultType="string">
        select '总计:' || COUNT(*) || '笔,金额:' || coalesce(SUM(settle_amount), 0)
        from settlement
        where settle_date = #{vDate, jdbcType=DATE, javaType=java.sql.Date}
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:442-442 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.selectSpGotoDeepEscape -->
    <select id="selectSpGotoDeepEscape" parameterType="long" resultType="java.util.LinkedHashMap">
        select
          order_id,
          customer_id,
          order_type
        from bulk_orders
        where batch_id = #{pBatchId, jdbcType=BIGINT, javaType=Long}
          AND process_flag = 'N'
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:442-442 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.selectSpGotoDeepEscape_1 -->
    <select id="selectSpGotoDeepEscape_1" resultType="java.util.LinkedHashMap">
        select 1
        from black_list
        where customer_id = #{mainRec.customer_id}
          AND active = 'Y'
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:460-460 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.updateSpGotoDeepEscape -->
    <update id="updateSpGotoDeepEscape">
        update bulk_orders set process_flag = 'BLACKLIST', process_time = current_timestamp where order_id = #{mainRec.order_id}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:460-460 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.selectSpGotoDeepEscape_2 -->
    <select id="selectSpGotoDeepEscape_2" resultType="java.util.LinkedHashMap">
        select
          rule_id,
          threshold
        from risk_rules
        where rule_type = #{mainRec.order_type}
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:472-472 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.selectSpGotoDeepEscape_3 -->
    <select id="selectSpGotoDeepEscape_3" resultType="int">
        select risk_score
        from customer_risk
        where customer_id = #{mainRec.customer_id}
          AND rule_id = #{riskRec.rule_id}
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:477-477 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.updateSpGotoDeepEscape_1 -->
    <update id="updateSpGotoDeepEscape_1">
        update bulk_orders set process_flag = 'RISK_REJECT', reject_reason = 'RULE_' || #{riskRec.rule_id} where order_id = #{mainRec.order_id}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:477-477 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.selectSpGotoDeepEscape_4 -->
    <select id="selectSpGotoDeepEscape_4" resultType="java.util.LinkedHashMap">
        select
          product_id,
          required_qty
        from order_items
        where order_id = #{mainRec.order_id}
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:494-494 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.selectSpGotoDeepEscape_5 -->
    <select id="selectSpGotoDeepEscape_5" resultType="int">
        select available_qty
        from inventory
        where product_id = #{stockRec.product_id}
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:497-497 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.updateSpGotoDeepEscape_2 -->
    <update id="updateSpGotoDeepEscape_2">
        update bulk_orders set process_flag = 'NO_STOCK', reject_reason = 'PROD_' || #{stockRec.product_id} where order_id = #{mainRec.order_id}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:505-505 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_deep_escape.updateSpGotoDeepEscape_3 -->
    <update id="updateSpGotoDeepEscape_3">
        update bulk_orders set process_flag = 'PASSED', process_time = current_timestamp where order_id = #{mainRec.order_id}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:528-528 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateSpGotoStateMachine -->
    <update id="updateSpGotoStateMachine">
        update orders set status = 'PENDING', submit_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:540-540 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateSpGotoStateMachine_1 -->
    <update id="updateSpGotoStateMachine_1">
        update orders set status = 'PAID', pay_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:545-545 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateSpGotoStateMachine_2 -->
    <update id="updateSpGotoStateMachine_2">
        update orders set status = 'CANCELLED', cancel_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:553-553 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateSpGotoStateMachine_3 -->
    <update id="updateSpGotoStateMachine_3">
        update orders set retry_count = #{vRetry, jdbcType=INTEGER, javaType=Integer}, last_retry = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:557-557 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateSpGotoStateMachine_4 -->
    <update id="updateSpGotoStateMachine_4">
        update orders set status = 'EXPIRED' where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:566-566 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateSpGotoStateMachine_5 -->
    <update id="updateSpGotoStateMachine_5">
        update orders set status = 'SHIPPED', ship_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:571-571 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateSpGotoStateMachine_6 -->
    <update id="updateSpGotoStateMachine_6">
        update orders set status = 'REFUNDING', refund_apply_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:580-580 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateSpGotoStateMachine_7 -->
    <update id="updateSpGotoStateMachine_7">
        update orders set status = 'COMPLETED', complete_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:585-585 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateSpGotoStateMachine_8 -->
    <update id="updateSpGotoStateMachine_8">
        update orders set status = 'REFUNDING', refund_apply_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:594-594 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateSpGotoStateMachine_9 -->
    <update id="updateSpGotoStateMachine_9">
        update orders set status = 'REFUNDED', refund_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:600-600 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateSpGotoStateMachine_10 -->
    <update id="updateSpGotoStateMachine_10">
        update orders set status = 'PAID', refund_reject_time = current_timestamp where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:606-606 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.updateSpGotoStateMachine_11 -->
    <update id="updateSpGotoStateMachine_11">
        update orders set status = 'PAID', partial_refund_amt = 100 where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:618-618 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.selectSpGotoStateMachine -->
    <select id="selectSpGotoStateMachine" resultType="string">
        select status
        from orders
        where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:629-629 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.insertSpGotoStateMachine -->
    <insert id="insertSpGotoStateMachine">
        insert into state_transitions (order_id, event, from_state, to_state, trans_time) values (#{pOrderId, jdbcType=BIGINT, javaType=Long}, #{pEvent, jdbcType=VARCHAR, javaType=String}, 'AUTO', #{vState, jdbcType=VARCHAR, javaType=String}, current_timestamp)
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:683-683 — PKG_WARPDRIVER_STRESS_TEST.sp_dynamic_scheduler_dispatch.insertSpDynamicSchedulerDispatch -->
    <insert id="insertSpDynamicSchedulerDispatch">
        insert into job_dispatch_log (job_name, task_id, dispatch_time, status) values (#{vJobName, jdbcType=VARCHAR, javaType=String}, #{vTaskId, jdbcType=BIGINT, javaType=Long}, current_timestamp, 'DISPATCHED')
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:709-709 — PKG_WARPDRIVER_STRESS_TEST.fn_recursive_tree_cleanup.selectFnRecursiveTreeCleanup -->
    <select id="selectFnRecursiveTreeCleanup" resultType="java.util.LinkedHashMap">
        select node_id
        from tree_nodes
        where parent_id = #{pParentId, jdbcType=BIGINT, javaType=Long}
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:718-718 — PKG_WARPDRIVER_STRESS_TEST.fn_recursive_tree_cleanup.deleteFnRecursiveTreeCleanup -->
    <delete id="deleteFnRecursiveTreeCleanup">
        delete from tree_attributes where node_id = #{vChildId, jdbcType=BIGINT, javaType=Long}
    </delete>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:719-719 — PKG_WARPDRIVER_STRESS_TEST.fn_recursive_tree_cleanup.deleteFnRecursiveTreeCleanup_1 -->
    <delete id="deleteFnRecursiveTreeCleanup_1">
        delete from tree_nodes where node_id = #{vChildId, jdbcType=BIGINT, javaType=Long}
    </delete>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:777-777 — PKG_WARPDRIVER_STRESS_TEST.fn_multi_cursor_return.selectFnMultiCursorReturn -->
    <select id="selectFnMultiCursorReturn" parameterType="long" resultType="java.util.LinkedHashMap">
        select
          order_id,
          total_amount,
          status,
          create_time
        from orders
        where customer_id = #{pCustomerId, jdbcType=BIGINT, javaType=Long}
        order by create_time desc
        limit 100
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:784-784 — PKG_WARPDRIVER_STRESS_TEST.fn_multi_cursor_return.selectFnMultiCursorReturn_1 -->
    <select id="selectFnMultiCursorReturn_1" parameterType="long" resultType="java.util.LinkedHashMap">
        select
          payment_id,
          pay_amount,
          pay_channel,
          pay_time
        from payments
        where customer_id = #{pCustomerId, jdbcType=BIGINT, javaType=Long}
          AND pay_status = 'SUCCESS'
        order by pay_time desc
        limit 100
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:792-792 — PKG_WARPDRIVER_STRESS_TEST.fn_multi_cursor_return.selectFnMultiCursorReturn_2 -->
    <select id="selectFnMultiCursorReturn_2" parameterType="long" resultType="int">
        select COUNT(*)
        from orders
        where customer_id = #{pCustomerId, jdbcType=BIGINT, javaType=Long}
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:793-793 — PKG_WARPDRIVER_STRESS_TEST.fn_multi_cursor_return.selectFnMultiCursorReturn_3 -->
    <select id="selectFnMultiCursorReturn_3" parameterType="long" resultType="int">
        select COUNT(*)
        from payments
        where customer_id = #{pCustomerId, jdbcType=BIGINT, javaType=Long}
          AND pay_status = 'SUCCESS'
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:812-812 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.selectSpSavepointHell -->
    <select id="selectSpSavepointHell" resultType="java.math.BigDecimal">
        select balance
        from accounts
        where account_id = #{pAccountId, jdbcType=BIGINT, javaType=Long}
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:818-818 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.updateSpSavepointHell -->
    <update id="updateSpSavepointHell">
        update accounts set balance = balance - #{pAmount, jdbcType=NUMERIC, javaType=java.math.BigDecimal}, pre_amount = #{pAmount, jdbcType=NUMERIC, javaType=java.math.BigDecimal} where account_id = #{pAccountId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:825-825 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.insertSpSavepointHell -->
    <insert id="insertSpSavepointHell">
        insert into account_journal (account_id, dr_amount, cr_amount, remark) values (#{pAccountId, jdbcType=BIGINT, javaType=Long}, #{pAmount, jdbcType=NUMERIC, javaType=java.math.BigDecimal}, 0, 'PRE_DEBIT')
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:832-832 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.updateSpSavepointHell_1 -->
    <update id="updateSpSavepointHell_1">
        update accounts set frozen_flag = 'Y' where account_id = #{pAccountId, jdbcType=BIGINT, javaType=Long}
    </update>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:833-833 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.insertSpSavepointHell_1 -->
    <insert id="insertSpSavepointHell_1">
        insert into risk_events (account_id, event_type, event_time) values (#{pAccountId, jdbcType=BIGINT, javaType=Long}, 'OVERDRAW', current_timestamp)
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:843-843 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.insertSpSavepointHell_2 -->
    <insert id="insertSpSavepointHell_2">
        insert into notifications (account_id, notify_type, content) values (#{pAccountId, jdbcType=BIGINT, javaType=Long}, 'SMS', 'Debit ' || #{pAmount, jdbcType=NUMERIC, javaType=java.math.BigDecimal})
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:857-857 — PKG_WARPDRIVER_STRESS_TEST.sp_savepoint_hell.selectSpSavepointHell_1 -->
    <select id="selectSpSavepointHell_1" resultType="object">
        select balance
        from accounts
        where account_id = #{pAccountId, jdbcType=BIGINT, javaType=Long}
                LIMIT 1
    </select>

    <select id="selectNextval" resultType="long">
            SELECT nextval(#{seqName, jdbcType=VARCHAR}) AS val
    </select>

</mapper>