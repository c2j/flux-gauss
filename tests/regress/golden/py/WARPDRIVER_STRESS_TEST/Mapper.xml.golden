    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:709-709 — PKG_WARPDRIVER_STRESS_TEST.fn_recursive_tree_cleanup.selectFnRecursiveTreeCleanup_13 -->
    <select id="selectFnRecursiveTreeCleanup_13" resultType="java.util.LinkedHashMap">
