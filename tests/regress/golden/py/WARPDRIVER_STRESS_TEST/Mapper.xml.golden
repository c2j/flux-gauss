        where order_id = #{pOrderId, jdbcType=BIGINT, javaType=Long}
                LIMIT 1
    </select>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:629-629 — PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine.insertStateTransitions_1 -->
    <insert id="insertStateTransitions_1">
        insert into state_transitions (order_id, event, from_state, to_state, trans_time) values (#{pOrderId, jdbcType=BIGINT, javaType=Long}, #{pEvent, jdbcType=VARCHAR, javaType=String}, 'AUTO', #{vState, jdbcType=VARCHAR, javaType=String}, current_timestamp)
    </insert>

    <!-- Source: PKG_WARPDRIVER_STRESS_TEST.sql:683-683 — PKG_WARPDRIVER_STRESS_TEST.sp_dynamic_scheduler_dispatch.insertJobDispatchLog -->
    <insert id="insertJobDispatchLog">
