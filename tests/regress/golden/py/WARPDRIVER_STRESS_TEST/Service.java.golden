            vItem = vArr;
            vNewPrice = java.math.BigDecimal.valueOf((0)).multiply((java.math.BigDecimal.valueOf(1).subtract(pDiscount)));
            vResult = vResult + this.jsonbBuildObject("product_id", String.valueOf(0), "original_price", String.valueOf((0)), "discount_rate", String.valueOf(pDiscount), "final_price", String.valueOf((vNewPrice).setScale((int)(2), java.math.RoundingMode.HALF_UP)), "processed_at", String.valueOf(new java.sql.Timestamp(System.currentTimeMillis())));
        }
        return this.jsonbBuildObject("items", String.valueOf(vResult), "total_count", String.valueOf(this.jsonbArrayLength(vArr)), "summary_discount", String.valueOf(pDiscount));
    }

