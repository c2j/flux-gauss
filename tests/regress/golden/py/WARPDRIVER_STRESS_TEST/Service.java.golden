            List<Map<String, Object>> stockRecList_8 = warpdriverStressTestMapper.selectSpGotoDeepEscape_4(pBatchId, mainRec);
            if (stockRecList_8 == null) stockRecList_8 = new ArrayList<>();
            for (Map<String, Object> stockRec : stockRecList_8) {
                vStock = warpdriverStressTestMapper.selectSpGotoDeepEscape_5(pBatchId, stockRec);
                if (vStock == null) vStock = 0;
                if (java.math.BigDecimal.valueOf(vStock).compareTo(java.math.BigDecimal.valueOf(((Number) (stockRec.get("required_qty") != null ? stockRec.get("required_qty") : 0L)).longValue())) < 0) {
                    vInvalid = vInvalid + 1;
                    _sqlRowCount = warpdriverStressTestMapper.updateSpGotoDeepEscape_2(pBatchId, mainRec, stockRec);
                    continue;
