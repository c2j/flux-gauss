    // Source: PKG_WARPDRIVER_STRESS_TEST.sp_goto_state_machine (PROCEDURE) — PKG_WARPDRIVER_STRESS_TEST.sql:517-632
    @Transactional
    public void spGotoStateMachine(Long pOrderId, String pEvent, AtomicReference<String> pFinalState) {
        String vState = "INIT";
        Integer vRetry = Integer.valueOf(0);
        Integer vMaxRetry = Integer.valueOf(3);
        String vDbState = null;
        int _sqlRowCount = 0;
        boolean running = true;
        int _smGuard = 0;
        pFinalState.set(null);
        // State machine generated from GOTO labels
        enum SpGotoStateMachineState {StateInit, StatePending, StatePaid, StateShipped, StateRefunding, StateCheck, StateDone}
        SpGotoStateMachineState currentState = SpGotoStateMachineState.StateInit;
        while (running && _smGuard++ < 10000) {
            switch (currentState) {
                case StateInit:
                if ("SUBMIT".equals(pEvent)) {
                    _sqlRowCount = warpdriverStressTestMapper.updateSpGotoStateMachine(pOrderId, pEvent);
                    vState = "PENDING";
                    currentState = SpGotoStateMachineState.StatePending;
                    break;
                } else if ("RESUME".equals(pEvent)) {
                    currentState = SpGotoStateMachineState.StateCheck;
                    break;
                }
                case StatePending:
                if ("PAY".equals(pEvent)) {
                    _sqlRowCount = warpdriverStressTestMapper.updateSpGotoStateMachine_1(pOrderId, pEvent);
                    vState = "PAID";
                    currentState = SpGotoStateMachineState.StatePaid;
                    break;
                } else if ("CANCEL".equals(pEvent)) {
                    _sqlRowCount = warpdriverStressTestMapper.updateSpGotoStateMachine_2(pOrderId, pEvent);
                    vState = "CANCELLED";
                    currentState = SpGotoStateMachineState.StateDone;
                    break;
                } else if ("TIMEOUT".equals(pEvent)) {
                    if (vRetry < vMaxRetry) {
                        vRetry = vRetry + 1;
                        _sqlRowCount = warpdriverStressTestMapper.updateSpGotoStateMachine_3(pOrderId, pEvent, vRetry);
                        currentState = SpGotoStateMachineState.StatePending;
                        break;
                    } else {
                        _sqlRowCount = warpdriverStressTestMapper.updateSpGotoStateMachine_4(pOrderId, pEvent);
                        vState = "EXPIRED";
                        currentState = SpGotoStateMachineState.StateDone;
                        break;
                    }
                }
                case StatePaid:
                if ("SHIP".equals(pEvent)) {
                    _sqlRowCount = warpdriverStressTestMapper.updateSpGotoStateMachine_5(pOrderId, pEvent);
                    vState = "SHIPPED";
                    currentState = SpGotoStateMachineState.StateShipped;
                    break;
                } else if ("REFUND_REQ".equals(pEvent)) {
                    _sqlRowCount = warpdriverStressTestMapper.updateSpGotoStateMachine_6(pOrderId, pEvent);
                    vState = "REFUNDING";
                    currentState = SpGotoStateMachineState.StateRefunding;
                    break;
                }
                case StateShipped:
                if ("DELIVER".equals(pEvent)) {
                    _sqlRowCount = warpdriverStressTestMapper.updateSpGotoStateMachine_7(pOrderId, pEvent);
                    vState = "COMPLETED";
                } else if ("RETURN".equals(pEvent)) {
                    _sqlRowCount = warpdriverStressTestMapper.updateSpGotoStateMachine_8(pOrderId, pEvent);
                    vState = "REFUNDING";
                    currentState = SpGotoStateMachineState.StateRefunding;
                    break;
                }
                case StateRefunding:
                if ("REFUND_APPROVE".equals(pEvent)) {
                    _sqlRowCount = warpdriverStressTestMapper.updateSpGotoStateMachine_9(pOrderId, pEvent);
                    vState = "REFUNDED";
                    currentState = SpGotoStateMachineState.StateDone;
                    break;
                } else if ("REFUND_REJECT".equals(pEvent)) {
                    _sqlRowCount = warpdriverStressTestMapper.updateSpGotoStateMachine_10(pOrderId, pEvent);
                    vState = "PAID";
                    currentState = SpGotoStateMachineState.StatePaid;
                    break;
                } else if ("PARTIAL_REFUND".equals(pEvent)) {
                    _sqlRowCount = warpdriverStressTestMapper.updateSpGotoStateMachine_11(pOrderId, pEvent);
                    vState = "PAID";
                    currentState = SpGotoStateMachineState.StatePaid;
                    break;
                }
                case StateCheck:
                vDbState = warpdriverStressTestMapper.selectSpGotoStateMachine(pOrderId, pEvent);
                vState = vDbState;
                if ("PENDING".equals(vDbState)) {
                    currentState = SpGotoStateMachineState.StatePending;
                    break;
                }
                if ("PAID".equals(vDbState)) {
                    currentState = SpGotoStateMachineState.StatePaid;
                    break;
                }
                if ("SHIPPED".equals(vDbState)) {
                    currentState = SpGotoStateMachineState.StateShipped;
                    break;
                }
                if ("REFUNDING".equals(vDbState)) {
                    currentState = SpGotoStateMachineState.StateRefunding;
                    break;
                }
                currentState = SpGotoStateMachineState.StateDone;
                break;
                case StateDone:
                pFinalState.set(String.valueOf(vState));
                _sqlRowCount = warpdriverStressTestMapper.insertSpGotoStateMachine(pOrderId, pEvent, vState);
                // COMMIT — auto-committed by Spring @Transactional boundary
                running = false;
                break;
                default:
                running = false;
                break;
            }
        }
    }

