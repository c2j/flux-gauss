<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.Issue124CollectionsMapper">

    <!-- Source: issue_124_collections.sql:32-32 — pkg_coll_types.prc_collection_demo.selectEmp -->
    <select id="selectEmp" parameterType="string" resultType="java.util.LinkedHashMap">
        select
          item_id,
          item_name
        from emp
    </select>

    <!-- Source: issue_124_collections.sql:35-35 — pkg_coll_types.prc_collection_demo.updateCfgTable -->
    <update id="updateCfgTable">
        update cfg_table set val = #{vCnt, jdbcType=BIGINT, javaType=Long} where key = #{pMode, jdbcType=VARCHAR, javaType=String}
    </update>

</mapper>