package com.example.demo.service;

import com.example.demo.exception.BusinessException;
import com.example.demo.mapper.Issue124CollectionsMapper;
import com.example.demo.service.Issue124CollectionsService;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.mockito.junit.jupiter.MockitoSettings;
import org.mockito.quality.Strictness;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
@MockitoSettings(strictness = Strictness.LENIENT)
class Issue124CollectionsServiceTest {

    @Mock
    private Issue124CollectionsMapper issue124CollectionsMapper;

    @InjectMocks
    private Issue124CollectionsService service;

    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_prcCollectionDemo_success() {
        String pMode = "test_pMode";
        var _rowTmpl = new java.util.HashMap<String,Object>(); _rowTmpl.put("count", 5);
        { var m = new java.util.HashMap<String,Object>(); m.put("item_id", 1); m.put("item_name", "test"); m.putAll(_rowTmpl); when(issue124CollectionsMapper.selectEmp(any())).thenReturn(java.util.List.of(m)).thenReturn(java.util.List.of()); }
        when(issue124CollectionsMapper.updateCfgTable(any(), any())).thenReturn(1);
        service.prcCollectionDemo(pMode);
        verify(issue124CollectionsMapper, atLeast(0)).updateCfgTable(any(), any());
    }

    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_prcCollectionIndexDemo_success() {
        String pMode = "test_pMode";
        var _rowTmpl = new java.util.HashMap<String,Object>(); _rowTmpl.put("count", 5);
        { var m = new java.util.HashMap<String,Object>(); m.put("item_id", 1); m.put("item_name", "test"); m.putAll(_rowTmpl); when(issue124CollectionsMapper.selectEmp(any())).thenReturn(java.util.List.of(m)).thenReturn(java.util.List.of()); }
        when(issue124CollectionsMapper.updateCfgTable(any(), any())).thenReturn(1);
        service.prcCollectionIndexDemo(pMode);
    }
}