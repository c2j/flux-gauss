package com.example.demo.service;

import com.example.demo.exception.BusinessException;
import com.example.demo.mapper.Issue144ChainLoopFieldMapper;
import com.example.demo.service.Issue144ChainLoopFieldService;
import java.util.concurrent.atomic.AtomicReference;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.mockito.junit.jupiter.MockitoSettings;
import org.mockito.quality.Strictness;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
@MockitoSettings(strictness = Strictness.LENIENT)
class Issue144ChainLoopFieldServiceTest {

    @Mock
    private Issue144ChainLoopFieldMapper issue144ChainLoopFieldMapper;

    @InjectMocks
    private Issue144ChainLoopFieldService service;

    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_prcMoveCols_success() {
        Long pIInstNum = 100L;
        String pIDataDate = "2024-01-01";
        AtomicReference<String> pORetcode = new AtomicReference<>(null);
        AtomicReference<String> pORetmsg = new AtomicReference<>(null);
        var _rowTmpl = new java.util.HashMap<String,Object>(); _rowTmpl.put("column_name", "test");
        { var m = new java.util.HashMap<String,Object>(); m.put("column_name", "test"); m.putAll(_rowTmpl); when(issue144ChainLoopFieldMapper.selectPrcMoveCols(any(), any(), any())).thenReturn(java.util.List.of(m)).thenReturn(java.util.List.of()); }
        when(issue144ChainLoopFieldMapper.insertPrcMoveCols(any(), any(), any(), any(), any(), any(), any())).thenReturn(1);
        service.prcMoveCols(pIInstNum, pIDataDate, pORetcode, pORetmsg);
        verify(issue144ChainLoopFieldMapper, atLeast(0)).insertPrcMoveCols(any(), any(), any(), any(), any(), any(), any());
    }
}