    // Source: issue_144_while_date_arith.get_section_begin_date (FUNCTION) — issue_144_while_date_arith.sql:27-61
    public String getSectionBeginDate(String pIStartDate, String pIEndDate, String pISettleFrequency, String pISettleFreqCount) {
        String vStartDate = pIStartDate;
        java.sql.Date vSectionStartDay = null;
        if (pIStartDate.compareTo(pIEndDate) > 0) {
            return "0";
        } else {
            if (java.util.Objects.equals(pISettleFrequency, "5")) {
                vSectionStartDay = _parseDate("yyyyMMdd", String.valueOf(pIStartDate));
                while (vSectionStartDay.compareTo(new java.sql.Timestamp(_parseDate("yyyyMMdd", String.valueOf(pIEndDate)).getTime() - ((Number) (7)).longValue() * 86400000L)) <= 0) {
                    vSectionStartDay = new java.sql.Date(vSectionStartDay.getTime() + ((Number) (7)).longValue() * 86400000L);
                }
            } else if (java.util.Objects.equals(pISettleFrequency, "6")) {
                vSectionStartDay = _parseDate("yyyyMMdd", String.valueOf(pIStartDate));
                while (vSectionStartDay.compareTo(new java.sql.Timestamp(_parseDate("yyyyMMdd", String.valueOf(pIEndDate)).getTime() - (pISettleFreqCount != null ? Long.parseLong(String.valueOf(pISettleFreqCount)) : 0L) * 86400000L)) <= 0) {
                    vSectionStartDay = new java.sql.Date(vSectionStartDay.getTime() + (pISettleFreqCount != null ? Long.parseLong(String.valueOf(pISettleFreqCount)) : 0L) * 86400000L);
                }
            } else {
                return pIStartDate;
            }
            return new java.text.SimpleDateFormat("yyyyMMdd").format(vSectionStartDay);
        }
        return "";
    }

