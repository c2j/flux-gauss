    public void prcInterestByAmount(DepositReceipt pIDepositReceipt, String pIAmount, AtomicReference<Long> pOAccrualValue) {
        Long vTmp = 0L;
        pOAccrualValue.set(null);
        vTmp = ((Number) ((new java.math.BigDecimal(String.valueOf(pIAmount)).divide((new java.math.BigDecimal(String.valueOf(pIDepositReceipt.amount.doubleValue())).add(new java.math.BigDecimal(String.valueOf((Double.valueOf(pIDepositReceipt.drawAmount.doubleValue()) != null ? Double.valueOf(pIDepositReceipt.drawAmount.doubleValue()) : 0)))))).multiply(java.math.BigDecimal.valueOf(2))).setScale((int)(2), java.math.RoundingMode.HALF_UP))).longValue();
        pOAccrualValue.set(((Number) vTmp).longValue());
    }
