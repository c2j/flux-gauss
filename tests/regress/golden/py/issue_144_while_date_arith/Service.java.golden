    private java.sql.Date _parseDate(String fmt, String str) {
        try {
            return new java.sql.Date(new java.text.SimpleDateFormat(fmt).parse(str).getTime());
        } catch (java.text.ParseException e) {
            try {
                return java.sql.Date.valueOf(java.time.LocalDate.parse(str.trim().split(" ")[0], java.time.format.DateTimeFormatter.ofPattern("[yyyy-MM-dd][yyyyMMdd]")));
