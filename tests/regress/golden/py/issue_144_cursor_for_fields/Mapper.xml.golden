<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.Issue144CursorForFieldsMapper">

    <!-- Source: issue_144_cursor_for_fields.sql:32-32 — pkg_issue144cf.prc_cursor_fields.selectPrcCursorFields -->
    <select id="selectPrcCursorFields" parameterType="string" resultType="java.util.LinkedHashMap">
        select
          t.cap_date,
          t.maturity_date,
          t.withdrawal_date,
          t.last_withdrawal_date,
          t.submit_date
        from dat_inst_base_info_144 AS t
        where t.fund_code = #{pInFundCode, jdbcType=VARCHAR, javaType=String}
    </select>

</mapper>