package com.example.demo.service;

import com.example.demo.exception.BusinessException;
import com.example.demo.mapper.Issue143SublinkMapper;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
public class Issue143SublinkService {
    private static final Logger log = LoggerFactory.getLogger(Issue143SublinkService.class);

    private final Issue143SublinkMapper issue143SublinkMapper;

    public Issue143SublinkService(Issue143SublinkMapper issue143SublinkMapper) {
        this.issue143SublinkMapper = issue143SublinkMapper;
    }

    private <T> T _unsupportedScalarSublink(String procId) {
        // ScalarSublink 子查询谓词暂不支持 — 显式失败而非静默降级（PR #143 review）
        throw new UnsupportedOperationException("ScalarSublink subquery predicate not supported at " + procId);
    }
    // Source: pkg_issue143sub.f_any (FUNCTION) — issue_143_sublink.sql:10-16
    public Long fAny(Long pValue) {
        if (_unsupportedScalarSublink("pkg_issue143sub.f_any")) {
            return Long.valueOf(1L);
        }
        return Long.valueOf(0L);
    }
}