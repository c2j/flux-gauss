    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_prcGetZsPrice_success() {
        String pISecurityId = "test_pISecurityId";
        String pIMarketType = "test_pIMarketType";
        AtomicReference<java.math.BigDecimal> pOMarketPrice = new AtomicReference<>(null);
        AtomicReference<String> pOPassFlag = new AtomicReference<>(null);
        AtomicReference<String> pOSucceed = new AtomicReference<>(null);
        when(issue61OuterExceptionBraceMapper.selectTIssue61Bond(any(), any())).thenReturn(null);
        when(issue61OuterExceptionBraceMapper.selectTIssue61Bond_1(any(), any())).thenReturn(null);
        when(issue61OuterExceptionBraceMapper.selectTIssue61Bond_2(any(), any())).thenReturn(null);
        service.prcGetZsPrice(pISecurityId, pIMarketType, pOMarketPrice, pOPassFlag, pOSucceed);
    }
}