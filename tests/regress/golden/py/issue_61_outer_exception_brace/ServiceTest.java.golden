@ExtendWith(MockitoExtension.class)
@MockitoSettings(strictness = Strictness.LENIENT)
class Issue61OuterExceptionBraceServiceTest {

    @Mock
    private Issue61OuterExceptionBraceMapper issue61OuterExceptionBraceMapper;

    @InjectMocks
