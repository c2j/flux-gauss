<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.Issue61OuterExceptionBraceMapper">

    <!-- Source: issue_61_outer_exception_brace.sql:36-36 — pkg_issue61_exc.prc_get_zs_price.selectTIssue61Bond -->
    <select id="selectTIssue61Bond" parameterType="string" resultType="object">
        select t.market_price
        from t_issue61_bond AS t
        where t.security_id = #{pISecurityId, jdbcType=VARCHAR, javaType=String}
          AND t.market_type = 'A'
                LIMIT 1
    </select>

    <!-- Source: issue_61_outer_exception_brace.sql:46-46 — pkg_issue61_exc.prc_get_zs_price.selectTIssue61Bond_1 -->
    <select id="selectTIssue61Bond_1" parameterType="string" resultType="object">
        select t.market_price
        from t_issue61_bond AS t
        where t.security_id = #{pISecurityId, jdbcType=VARCHAR, javaType=String}
          AND t.market_type = 'B'
                LIMIT 1
    </select>

    <!-- Source: issue_61_outer_exception_brace.sql:56-56 — pkg_issue61_exc.prc_get_zs_price.selectTIssue61Bond_2 -->
    <select id="selectTIssue61Bond_2" parameterType="string" resultType="object">
        select t.market_price
        from t_issue61_bond AS t
        where t.security_id = #{pISecurityId, jdbcType=VARCHAR, javaType=String}
                LIMIT 1
    </select>

</mapper>