<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.Issue144MapperArgFieldsMapper">

    <!-- Source: issue_144_mapper_arg_fields.sql:40-40 — pkg_issue144mp.prc_model_loop.selectPrcModelLoop -->
    <select id="selectPrcModelLoop" parameterType="string" resultType="java.util.LinkedHashMap">
        select
          table_name,
          diff_column,
          diff_value
        from par_issue144_model AS t
        where t.operation_no = #{pIOperationNo, jdbcType=VARCHAR, javaType=String}
        order by t.forest_no
    </select>

    <!-- Source: issue_144_mapper_arg_fields.sql:53-53 — pkg_issue144mp.prc_model_loop.selectPrcModelLoop_1 -->
    <select id="selectPrcModelLoop_1" parameterType="string" resultType="java.util.LinkedHashMap">
        SELECT
          xmlforest(: element_name)
        FROM #{s_table_name}
        WHERE SEQ_NO = : seq_no ' AND ' || #{s_diff_column} || '= '' || #{s_diff_value} || '''
                LIMIT 1
    </select>

</mapper>