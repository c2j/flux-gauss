        { var m = new java.util.HashMap<String,Object>(); m.put("table_name", "test"); m.put("diff_column", 1); m.put("diff_value", 1); m.putAll(_rowTmpl); when(issue144MapperArgFieldsMapper.selectPrcModelLoop(any())).thenReturn(java.util.List.of(m)).thenReturn(java.util.List.of()); }
        { var m = new java.util.HashMap<String,Object>(); m.put("xmlforest", 1); m.putAll(_rowTmpl); when(issue144MapperArgFieldsMapper.selectPrcModelLoop_1(any(), any())).thenReturn(m).thenReturn(null); }
