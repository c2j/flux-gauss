<mapper namespace="com.example.demo.mapper.Issue54NestedExceptionMapper">

    <!-- Source: issue_54_nested_exception.sql:27-27 — pkg_issue54_nested_exc.proc_nested_block_in_handler.selectTIssue54Data -->
