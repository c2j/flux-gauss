    <!-- Source: gauss_complete_examples.sql:594-594 — pkg_cursor_advanced.proc_cursor_dynamic_using.insertProcCursorDynamicUsing -->
    <insert id="insertProcCursorDynamicUsing">
        insert into audit_log (log_time, operation, sql_text, bind_params) values (current_timestamp, 'CURSOR_DYNAMIC_ USING', #{vSql, jdbcType=VARCHAR, javaType=String}, 'status=' || #{pStatusList, jdbcType=VARCHAR, javaType=String} || ',min=' || #{pMinAmount, jdbcType=NUMERIC, javaType=java.math.BigDecimal} || ',date=' || #{pStartDate, jdbcType=DATE, javaType=java.sql.Date})
    </insert>

    <!-- Source: gauss_complete_examples.sql:621-621 — pkg_cursor_advanced.func_get_order_cursor.selectFuncGetOrderCursor -->
    <select id="selectFuncGetOrderCursor" resultType="java.util.LinkedHashMap">
        select
          o.order_id,
          c.customer_name,
          SUM(oi.quantity * oi.unit_price) AS total_amount,
          COUNT(distinct oi.item_id) AS item_count,
          o.order_status
        from orders AS o
        inner join customers AS c
          on o.customer_id = c.customer_id
        inner join order_items AS oi
          on o.order_id = oi.order_id
        where o.customer_id = #{pCustomerId, jdbcType=INTEGER, javaType=Integer}
          AND o.order_date between #{pDateFrom, jdbcType=DATE, javaType=java.sql.Date} and #{pDateTo, jdbcType=DATE, javaType=java.sql.Date}
        group by o.order_id, c.customer_name, o.order_status
        order by total_amount desc
    </select>

    <!-- Source: gauss_complete_examples.sql:631-631 — pkg_cursor_advanced.proc_multi_cursor_return.selectProcMultiCursorReturn -->
    <select id="selectProcMultiCursorReturn" parameterType="integer" resultType="java.util.LinkedHashMap">
        select
          q.*,
          ROW_NUMBER() over (order by q.priority desc, q.create_time) AS rn
        from query_results AS q
        where q.query_id = #{param1}
        order by q.priority desc
    </select>

    <!-- Source: gauss_complete_examples.sql:638-638 — pkg_cursor_advanced.proc_multi_cursor_return.selectProcMultiCursorReturn_1 -->
    <select id="selectProcMultiCursorReturn_1" parameterType="integer" resultType="java.util.LinkedHashMap">
        select
          COUNT(*) AS total_rows,
          MIN(create_time) AS earliest,
          MAX(create_time) AS latest,
          COUNT(distinct status) AS status_distinct_count,
          AVG(case when amount IS not null then amount end) AS avg_amount,
          query_params
        from query_results
        where query_id = #{param1}
        group by query_params
    </select>

    <!-- Source: gauss_complete_examples.sql:669-669 — pkg_cursor_advanced.proc_paginate_with_using.selectProcPaginateWithUsing -->
    <select id="selectProcPaginateWithUsing" resultType="java.util.LinkedHashMap">
        select *
        from ${pBaseSql} AS t
        limit #{pPageSize, jdbcType=INTEGER, javaType=Integer}
        offset #{vOffset, jdbcType=INTEGER, javaType=Integer}
    </select>

    <!-- Source: gauss_complete_examples.sql:670-670 — pkg_cursor_advanced.proc_paginate_with_using.selectProcPaginateWithUsing_1 -->
    <select id="selectProcPaginateWithUsing_1" resultType="java.util.LinkedHashMap">
        select COUNT(*)
        from ${pBaseSql} AS t
    </select>

    <!-- Source: gauss_complete_examples.sql:709-709 — pkg_cursor_lifecycle.proc_get_raw_cursor.selectProcGetRawCursor -->
    <select id="selectProcGetRawCursor" parameterType="integer" resultType="java.util.LinkedHashMap">
        select
          emp_id AS employee_id,
          emp_name AS employee_name,
          base_salary AS salary,
          dept_id AS department_id,
          hire_date
        from employees
        where department_id = #{param1}
          AND status = 'ACTIVE'
        order by salary desc
    </select>

    <!-- Source: gauss_complete_examples.sql:728-728 — pkg_cursor_lifecycle.proc_enhance_cursor.updateProcEnhanceCursor -->
    <update id="updateProcEnhanceCursor">
        create table ${vTemp} (employee_id INTEGER, employee_name varchar2(100), salary NUMERIC(18, 2), department_id INTEGER, hire_date DATE, years_of_service NUMERIC(5, 2), salary_level varchar2(20), bonus_eligible INTEGER)
    </update>

    <!-- Source: gauss_complete_examples.sql:738-738 — pkg_cursor_lifecycle.proc_enhance_cursor.insertProcEnhanceCursor -->
    <insert id="insertProcEnhanceCursor">
        insert into ${vTemp} values (#{vId, jdbcType=INTEGER, javaType=Integer}, #{vName, jdbcType=VARCHAR, javaType=String}, #{vSalary, jdbcType=NUMERIC, javaType=java.math.BigDecimal}, #{vDeptId, jdbcType=INTEGER, javaType=Integer}, #{vHireDate, jdbcType=DATE, javaType=java.sql.Date}, extract(year from current_date) - extract(year from #{vHireDate, jdbcType=DATE, javaType=java.sql.Date}), case when #{vSalary, jdbcType=NUMERIC, javaType=java.math.BigDecimal} &gt; 80000 then 'SENIOR' else 'JUNIOR' end, case when extract(year from current_date) - extract(year from #{vHireDate, jdbcType=DATE, javaType=java.sql.Date}) &gt;= 2 then 1 else 0 end)
    </insert>

    <!-- Source: gauss_complete_examples.sql:748-748 — pkg_cursor_lifecycle.proc_enhance_cursor.selectProcEnhanceCursor -->
    <select id="selectProcEnhanceCursor" resultType="java.util.LinkedHashMap">
        'SELECT * FROM ' || #{vTemp, jdbcType=VARCHAR, javaType=String} || ' ORDER BY salary DESC'
    </select>

</mapper>