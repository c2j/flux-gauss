<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.GaussCompleteExamplesMapper">

    <!-- Source: gauss_complete_examples.sql:80-80 — pkg_for_in_select.proc_sync_employee_bonus.insertProcSyncEmployeeBonus -->
    <select id="insertProcSyncEmployeeBonus" resultType="java.util.LinkedHashMap">
        insert into batch_log (batch_id, batch_type, start_time, status) values (nextval('seq_batch_log'), 'BONUS_CALC', current_date, 'RUNNING') returning batch_id
    </select>

    <!-- Source: gauss_complete_examples.sql:84-84 — pkg_for_in_select.proc_sync_employee_bonus.selectProcSyncEmployeeBonus -->
    <select id="selectProcSyncEmployeeBonus" resultType="java.util.LinkedHashMap">
        select
          e.employee_id,
          e.employee_name,
          e.department_id,
          e.salary,
          e.hire_date,
          d.department_name,
          (
            select nvl(SUM(bonus_amount), 0)
            from employee_bonus AS eb
            where eb.emp_id = e.employee_id
              AND eb.bonus_year = extract(year from current_date)
          ) AS year_bonus_total
        from employees AS e
        inner join departments AS d
          on e.department_id = d.department_id
        where e.status = 'ACTIVE'
          AND e.hire_date &lt;= ADD_MONTHS(current_date, -6)
        order by e.department_id, e.salary desc
    </select>

    <!-- Source: gauss_complete_examples.sql:116-116 — pkg_for_in_select.proc_sync_employee_bonus.insertProcSyncEmployeeBonus_1 -->
    <insert id="insertProcSyncEmployeeBonus_1">
        insert into bonus_limit_log (log_time, emp_id, limit_reason) values (current_date, #{vEmp.employee_id}, 'Bonus capped at annual 20% limit')
    </insert>

    <!-- Source: gauss_complete_examples.sql:122-122 — pkg_for_in_select.proc_sync_employee_bonus.insertProcSyncEmployeeBonus_2 -->
    <select id="insertProcSyncEmployeeBonus_2" resultType="java.util.LinkedHashMap">
        insert into employee_bonus (bonus_id, emp_id, bonus_amount, bonus_month, bonus_year, calc_reason, create_time) values (nextval('seq_employee_bonus'), #{vEmp.employee_id}, #{vBonusAmt, jdbcType=NUMERIC, javaType=java.math.BigDecimal}, extract(month from current_date), extract(year from current_date), 'Q' || TO_CHAR(current_date, 'Q') || ' performance bonus', current_date) returning bonus_id
    </select>

    <!-- Source: gauss_complete_examples.sql:165-165 — pkg_for_in_select.proc_sync_employee_bonus.updateProcSyncEmployeeBonus -->
    <update id="updateProcSyncEmployeeBonus">
        update batch_log set end_time = current_date, status = 'SUCCESS', record_count = #{vProcessed, jdbcType=INTEGER, javaType=Integer}, total_amount = #{vTotalBonus, jdbcType=NUMERIC, javaType=java.math.BigDecimal}, message = 'Processed ' || #{vProcessed, jdbcType=INTEGER, javaType=Integer} || ' employees, total bonus: ' || #{vTotalBonus, jdbcType=NUMERIC, javaType=java.math.BigDecimal} where batch_id = #{vLogId, jdbcType=INTEGER, javaType=Integer}
    </update>

    <!-- Source: gauss_complete_examples.sql:227-227 — pkg_open_cursor.proc_get_employee_cursor.selectProcGetEmployeeCursor -->
    <select id="selectProcGetEmployeeCursor" resultType="java.util.LinkedHashMap">
        select
          e.employee_id,
          e.employee_name,
          e.salary,
          e.email,
          d.department_name,
          p.project_name,
          RANK() over (partition by e.department_id order by e.salary desc) AS dept_salary_rank,
          PERCENT_RANK() over (order by e.salary) AS salary_percentile
        from employees AS e
        left join departments AS d
          on e.department_id = d.department_id
        left join projects AS p
          on e.current_project_id = p.project_id
        where e.department_id = #{pDeptId, jdbcType=INTEGER, javaType=Integer}
          AND e.salary &gt;= #{pMinSalary, jdbcType=NUMERIC, javaType=java.math.BigDecimal}
          AND e.status = 'ACTIVE'
        order by e.salary desc
    </select>

    <!-- Source: gauss_complete_examples.sql:275-275 — pkg_open_cursor.proc_process_dynamic_query.insertProcProcessDynamicQuery -->
    <insert id="insertProcProcessDynamicQuery">
        insert into audit_log (log_time, operation, sql_text, user_name) values (current_timestamp, 'DYNAMIC_QUERY', #{vSql, jdbcType=VARCHAR, javaType=String}, "user" )
    </insert>

    <!-- Source: gauss_complete_examples.sql:278-278 — pkg_open_cursor.proc_process_dynamic_query.selectProcProcessDynamicQuery -->
    <select id="selectProcProcessDynamicQuery" parameterType="string" resultType="java.util.LinkedHashMap">
        SELECT id, name, amount, status, create_time FROM ${pTableName}
        <where>
            <if test="pWhereClause != null">AND ${pWhereClause}</if>
        </where>
        <if test="pOrderBy != null">ORDER BY ${pOrderBy}</if>
    </select>

    <!-- Source: gauss_complete_examples.sql:289-289 — pkg_open_cursor.proc_process_dynamic_query.updateProcProcessDynamicQuery -->
    <update id="updateProcProcessDynamicQuery">
        update ${pTableName} set status = 'PROCESSING', process_time = current_timestamp where id = #{vRecId, jdbcType=INTEGER, javaType=Integer}
    </update>

    <!-- Source: gauss_complete_examples.sql:296-296 — pkg_open_cursor.proc_process_dynamic_query.updateProcProcessDynamicQuery_1 -->
    <update id="updateProcProcessDynamicQuery_1">
        update ${pTableName} set status = 'TIMEOUT', retry_count = nvl(retry_count, 0) + 1 where id = #{vRecId, jdbcType=INTEGER, javaType=Integer}
    </update>

    <!-- Source: gauss_complete_examples.sql:303-303 — pkg_open_cursor.proc_process_dynamic_query.insertProcProcessDynamicQuery_1 -->
    <insert id="insertProcProcessDynamicQuery_1">
        insert into archive_table (id, name, amount, status, archived_time) values (#{vRecId, jdbcType=INTEGER, javaType=Integer}, #{vRecName, jdbcType=VARCHAR, javaType=String}, #{vRecValue, jdbcType=NUMERIC, javaType=java.math.BigDecimal}, #{vRecStatus, jdbcType=VARCHAR, javaType=String}, current_timestamp)
    </insert>

    <!-- Source: gauss_complete_examples.sql:306-306 — pkg_open_cursor.proc_process_dynamic_query.deleteProcProcessDynamicQuery -->
    <delete id="deleteProcProcessDynamicQuery">
        delete from ${pTableName} where id = #{vRecId, jdbcType=INTEGER, javaType=Integer}
    </delete>

    <!-- Source: gauss_complete_examples.sql:311-311 — pkg_open_cursor.proc_process_dynamic_query.insertProcProcessDynamicQuery_2 -->
    <insert id="insertProcProcessDynamicQuery_2">
        insert into exception_log (exception_time, record_id, exception_type, detail) values (current_timestamp, #{vRecId, jdbcType=INTEGER, javaType=Integer}, 'UNKNOWN_STATUS', #{vRecStatus, jdbcType=VARCHAR, javaType=String})
    </insert>

    <!-- Source: gauss_complete_examples.sql:331-331 — pkg_open_cursor.proc_process_dynamic_query.insertProcProcessDynamicQuery_3 -->
    <insert id="insertProcProcessDynamicQuery_3">
        insert into performance_log (log_time, procedure_name, rows_processed, elapsed_ms) values (current_timestamp, 'proc_process_dynamic_query', #{vRowCount, jdbcType=INTEGER, javaType=Integer}, extract(EPOCH from (current_timestamp - #{vStartTime, jdbcType=TIMESTAMP, javaType=java.sql.Timestamp})) * 1000)
    </insert>

    <!-- Source: gauss_complete_examples.sql:354-354 — pkg_open_cursor.proc_paginated_query.selectProcPaginatedQuery -->
    <select id="selectProcPaginatedQuery" resultType="java.util.LinkedHashMap">
        select
          t.*,
          COUNT(*) over () AS total_rows
        from (
          select
            emp_id AS employee_id,
            emp_name AS employee_name,
            dept_id AS department_id,
            base_salary AS salary,
            hire_date,
            ROW_NUMBER() over (order by employee_id) AS rn
          from employees
          where status = 'ACTIVE'
        ) AS t
        where rn &gt; #{vOffset, jdbcType=INTEGER, javaType=Integer}
          AND rn &lt;= #{vOffset, jdbcType=INTEGER, javaType=Integer} + #{pPageSize, jdbcType=INTEGER, javaType=Integer}
        order by rn
    </select>

    <!-- Source: gauss_complete_examples.sql:372-372 — pkg_open_cursor.proc_paginated_query.selectProcPaginatedQuery_1 -->
    <select id="selectProcPaginatedQuery_1" parameterType="integer" resultType="java.util.LinkedHashMap">
        select
          COUNT(*) AS total_count,
          COUNT(distinct dept_id) AS dept_count,
          ROUND(AVG(base_salary), 2) AS avg_salary,
          MIN(base_salary) AS min_salary,
          MAX(base_salary) AS max_salary
        from employees
        where status = 'ACTIVE'
    </select>

    <!-- Source: gauss_complete_examples.sql:431-431 — pkg_dynamic_for_loop.proc_dynamic_for_processing.insertProcDynamicForProcessing -->
    <insert id="insertProcDynamicForProcessing">
        insert into audit_log (log_time, operation, sql_text, params) values (current_timestamp, 'DYNAMIC_FOR_LOOP', #{vSql, jdbcType=VARCHAR, javaType=String}, 'table=' || #{pTableName, jdbcType=VARCHAR, javaType=String} || ',type=' || #{pProcessType, jdbcType=VARCHAR, javaType=String})
    </insert>

    <!-- Source: gauss_complete_examples.sql:435-435 — pkg_dynamic_for_loop.proc_dynamic_for_processing.selectProcDynamicForProcessing -->
    <select id="selectProcDynamicForProcessing" parameterType="string" resultType="java.util.LinkedHashMap">
        SELECT /* FunctionCall:nvl */ FROM ${pTableName}
        <where>
            <if test="pWhereClause != null">AND ${pWhereClause}</if>
        </where>
        <if test="pOrderBy != null">ORDER BY ${pOrderBy}</if>
    </select>

    <!-- Source: gauss_complete_examples.sql:480-480 — pkg_dynamic_for_loop.proc_dynamic_for_processing.insertProcDynamicForProcessing_1 -->
    <insert id="insertProcDynamicForProcessing_1">
        insert into performance_log (log_time, operation, rows_affected, elapsed_ms) values (current_timestamp, 'dynamic_for_' || #{pProcessType, jdbcType=VARCHAR, javaType=String}, #{vRowCount, jdbcType=INTEGER, javaType=Integer}, extract(EPOCH from (current_timestamp - #{vStartTime, jdbcType=TIMESTAMP, javaType=java.sql.Timestamp})) * 1000)
    </insert>

    <!-- Source: gauss_complete_examples.sql:584-584 — pkg_cursor_advanced.proc_cursor_dynamic_using.selectProcCursorDynamicUsing -->
    <select id="selectProcCursorDynamicUsing" resultType="java.util.LinkedHashMap">
        SELECT
                            t.id,
                            t.name,
                            t.status,
                            t.amount,
                            t.create_time,
                            t.customer_id,
                            c.customer_name,
                            CASE WHEN t.amount &gt; : THEN 'HIGH' ELSE 'NORMAL' END AS amount_level,
                            EXTRACT(DAY FROM (CURRENT_TIMESTAMP - :)) AS days_elapsed
                          FROM ${pTableName} t
                          LEFT JOIN customers c ON t.customer_id = c.customer_id
                          WHERE t.status IN (#{vInClause, jdbcType=VARCHAR, javaType=String} || ',')
                            AND t.amount &gt;= :
                            AND t.create_time &gt;= :
                          ORDER BY t.amount DESC
        <if test="true">:${i}</if>
    </select>

    <!-- Source: gauss_complete_examples.sql:586-586 — pkg_cursor_advanced.proc_cursor_dynamic_using.selectProcCursorDynamicUsing_1 -->
    <select id="selectProcCursorDynamicUsing_1" resultType="java.util.LinkedHashMap">
