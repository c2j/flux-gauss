    // Source: pkg_cursor_advanced.func_get_order_cursor (FUNCTION) — gauss_complete_examples.sql:599-623
    public Map<String, Object> funcGetOrderCursor(Integer pCustomerId, java.sql.Date pDateFrom, java.sql.Date pDateTo) {
        String vSql = null;
        int vCursorIdx = 0;
        List<Map<String, Object>> vCursorResult = null;
        Map<String, Object> vCursor = new HashMap<>();
        vSql = "SELECT\n                    o.order_id,\n                    c.customer_name,\n                    SUM(oi.quantity * oi.unit_price) AS total_amount,\n                    COUNT(DISTINCT oi.item_id) AS item_count,\n                    o.order_status\n                  FROM orders o\n                  JOIN customers c ON o.customer_id = c.customer_id\n                  JOIN order_items oi ON o.order_id = oi.order_id\n                  WHERE o.customer_id = :1\n                    AND o.order_date BETWEEN :2 AND :3\n                  GROUP BY o.order_id, c.customer_name, o.order_status\n                  ORDER BY total_amount DESC";
        vCursorResult = gaussCompleteExamplesMapper.selectFuncGetOrderCursor_10(pCustomerId, pDateFrom, pDateTo);
        vCursorIdx = 0;
        if (vCursorResult == null) vCursorResult = new java.util.ArrayList<>();
        return vCursor;
    }

