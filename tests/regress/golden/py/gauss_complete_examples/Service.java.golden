    // Source: string_split (FUNCTION) — gauss_complete_examples.sql:5-31
    public List<String> stringSplit(String pString, String pDelimiter) {
        Integer vStart = Integer.valueOf(1);
        Integer vEnd = 0;
        Integer vIdx = Integer.valueOf(1);
        List<String> vArray = new java.util.ArrayList<>();
        if (pString == null) {
            return vArray;
        }
        vEnd = (String.valueOf(pString).indexOf(String.valueOf(pDelimiter), Math.max(0, (vStart) - 1)) + 1);
        while (vEnd > 0) {
            // CALL v_array(...)
            vIdx = vIdx + 1;
            vStart = vEnd + String.valueOf(pDelimiter).length();
            vEnd = (String.valueOf(pString).indexOf(String.valueOf(pDelimiter), Math.max(0, (vStart) - 1)) + 1);
        }
        // CALL v_array(...)
        return vArray;
    }

