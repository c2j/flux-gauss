    // Source: pkg_for_in_select.func_get_bonus_rate (FUNCTION) — gauss_complete_examples.sql:63-73
    public java.math.BigDecimal funcGetBonusRate(Integer pDeptId) {
        java.math.BigDecimal vRate = java.math.BigDecimal.ZERO;
        if (pDeptId == 10) {
            vRate = java.math.BigDecimal.valueOf(0.15d);
        } else if (pDeptId == 20) {
            vRate = java.math.BigDecimal.valueOf(0.10d);
        } else if (pDeptId == 30) {
            vRate = java.math.BigDecimal.valueOf(0.08d);
        } else {
            vRate = java.math.BigDecimal.valueOf(0.05d);
        }
        return vRate;
    }

