    // Source: pkg_issue46_functions.proc_range_mapping (PROCEDURE) — issue_46_chr_ascii_substr.sql:126-143
    public void procRangeMapping(String pInput, AtomicReference<String> pResult) {
        Integer vNum = 0;
        pResult.set(null);
        vNum = String.valueOf(_substr(String.valueOf(pInput), (1), (1))).charAt(0);
        if (vNum >= 49 && vNum <= 57) {
            pResult.set(String.valueOf((char)(vNum + 16)));
        } else if (vNum >= 65 && vNum <= 74) {
            pResult.set(String.valueOf((char)(vNum - 16)));
        } else if (vNum >= 75 && vNum <= 84) {
            pResult.set(String.valueOf((char)(vNum - 30)));
        } else {
            pResult.set(String.valueOf((char)(vNum)));
        }
    }
