    private String _substr(String str, Object pos) {
        return _substr(str, pos, str.length());
    }

    private String _substr(String str, Object pos, Object len) {
        if (str == null) str = "";
        int p = (pos instanceof Number) ? ((Number) pos).intValue() : Integer.parseInt(String.valueOf(pos));
        int l = (len instanceof Number) ? ((Number) len).intValue() : Integer.parseInt(String.valueOf(len));
        int start = Math.max(0, p - 1);
        int end = Math.min(str.length(), start + l);
        if (start > end) start = end;
        return str.substring(start, end);
    }
    // Source: pkg_issue46_functions.proc_convert_trade_code (PROCEDURE) — issue_46_chr_ascii_substr.sql:61-76
    public void procConvertTradeCode(String pZqdm, AtomicReference<String> pResult) {
        Integer vChar1 = 0;
        Integer vChar2 = 0;
        String vChr = null;
        pResult.set(null);
        vChar1 = String.valueOf(_substr(String.valueOf(pZqdm), (5), (1))).charAt(0);
        vChar2 = String.valueOf(_substr(String.valueOf(pZqdm), (6), (1))).charAt(0);
        vChr = String.valueOf((char)(vChar1 + 48)) + _substr(String.valueOf(pZqdm), (7), (1));
        pResult.set(String.valueOf(vChr));
    }

