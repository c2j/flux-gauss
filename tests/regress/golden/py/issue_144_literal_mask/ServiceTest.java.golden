@ExtendWith(MockitoExtension.class)
@MockitoSettings(strictness = Strictness.LENIENT)
class Issue144LiteralMaskServiceTest {

    @Mock
    private Issue144LiteralMaskMapper issue144LiteralMaskMapper;

    @InjectMocks
    private Issue144LiteralMaskService service;

    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_prcDecodeLit_success() {
        String pIOperationNo = "test_pIOperationNo";
        String pIUsage = "test_pIUsage";
        String pIDataGroup = "test_pIDataGroup";
        var _rowTmpl = new java.util.HashMap<String,Object>(); _rowTmpl.put("table_name", "test");
        { var m = new java.util.HashMap<String,Object>(); m.put("table_name", "test"); m.put("his_table_name", "test"); m.putAll(_rowTmpl); when(issue144LiteralMaskMapper.selectPrcDecodeLit(any(), any(), any())).thenReturn(java.util.List.of(m)).thenReturn(java.util.List.of()); }
        service.prcDecodeLit(pIOperationNo, pIUsage, pIDataGroup);
    }

    @Test
    @org.junit.jupiter.api.Timeout(value = 5, unit = java.util.concurrent.TimeUnit.SECONDS)
    void test_genXml_success() {
        String pITable = "test_pITable";
        var _rowTmpl = new java.util.HashMap<String,Object>(); _rowTmpl.put("table_name", "test");
        { var m = new java.util.HashMap<String,Object>(); m.put("table_name", "test"); m.put("his_table_name", "test"); m.putAll(_rowTmpl); when(issue144LiteralMaskMapper.selectPrcDecodeLit(any(), any(), any())).thenReturn(java.util.List.of(m)).thenReturn(java.util.List.of()); }
        service.genXml(pITable);
    }
}